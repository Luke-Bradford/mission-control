+   text-decoration: none;
+ }
+
+ .loop-chip:hover {
+   color: var(--fg);
+ }
+
+ .loop-chip.tone-ok {
+   border-left-color: var(--ok);
+ }
+
+ .loop-chip.tone-warn {
+   border-left-color: var(--warn-mark);
+ }
+
+ .loop-chip.tone-crit {
+   border-left-color: var(--crit);
+ }
+
+ .loop-chip.tone-neutral {
+   border-left-color: var(--line-2);
+ }
+
+ .loop-chip.sel {
+   background: var(--surface);
