+
+ .pipeline-chip {
+   display: flex;
+   min-height: var(--sp-6);
+   align-items: center;
+   gap: var(--sp-1);
+   min-width: 0;
+   padding: var(--sp-1) var(--sp-1);
+   margin-top: var(--sp-1);
+   border: 1px solid var(--line);
+   border-radius: var(--r-s);
+   background: var(--surface-2);
+   color: var(--fg);
+   text-decoration: none;
+   font-size: var(--fs-s);
+ }
+
+ .pipeline-ticket {
+   flex: none;
+   color: var(--accent);
+   font-size: var(--fs-s);
+ }
+
+ .pipeline-skeleton {
+   height: 28px;
+ }
+
+ .pipeline-chip:hover {
+   border-color: var(--stage-colour);
+ }
+
+ .pipeline-title {
+   flex: 1;
+   min-width: 0;
+   white-space: nowrap;
+   overflow: hidden;
+   text-overflow: ellipsis;
