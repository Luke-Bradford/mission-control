+
+ .loop-route-label {
+   position: absolute;
+   z-index: 1;
+   padding: var(--sp-1) var(--sp-1);
+   border: 1px solid var(--warn);
+   border-radius: 999px;
+   background: var(--surface);
+   color: var(--warn);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   white-space: nowrap;
+ }
+
+ .ci-label {
+   top: 137px;
+   left: 370px;
+ }
+
+ .review-label {
+   top: 185px;
+   left: 430px;
+ }
+
+ .loop-chain-step {
+   position: relative;
+   z-index: 1;
+   display: grid;
+   align-content: start;
+   gap: var(--sp-1);
+   min-height: 96px;
+   padding: var(--sp-2);
+   text-align: left;
+   border: 1px solid var(--line-2);
+   border-radius: var(--r-s);
+   background: var(--surface);
+ }
+
+ .loop-chain-step:not(:last-of-type)::after {
+   position: absolute;
+   top: 47px;
+   left: 100%;
+   width: 34px;
+   border-top: 2px solid var(--line-2);
+   content: "";
+ }
+
+ .loop-chain-step.selected {
+   border: 2px solid var(--accent);
+ }
+
+ .loop-chain-step.now {
+   box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 28%, transparent);
+ }
+
+ .loop-chain-step span {
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+
+ .loop-chain-step small,
+ .loop-flight small {
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+ }
+
+ .loop-flight {
+   position: absolute;
+   top: 220px;
+   left: 1060px;
+   width: 190px;
+   display: grid;
+   align-content: center;
+   gap: var(--sp-1);
+   margin-left: var(--sp-2);
+   padding: var(--sp-2);
+   border: 1px solid var(--crit);
+   border-radius: var(--r-s);
+ }
+
+ .loop-flight span {
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+
+ .loop-details {
+   display: grid;
+   grid-template-columns: repeat(2, minmax(0, 1fr));
+   gap: var(--sp-2);
+ }
+
+ .loop-inspector {
+   display: grid;
+   grid-template-columns: 130px minmax(0, 1fr);
+   gap: var(--sp-2) var(--sp-3);
+   margin: 0;
+   padding: var(--sp-3) var(--sp-3);
+   font-size: var(--fs-s);
+ }
+
+ .loop-inspector dt {
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+ }
+
+ .loop-inspector dd {
+   min-width: 0;
+   margin: 0;
+ }
+
+ .loop-run {
+   display: grid;
+   gap: var(--sp-2);
+   padding: var(--sp-3) var(--sp-3);
+   font-size: var(--fs-s);
+ }
+
+ @media (max-width: 700px) {
+   .loop-details {
+     grid-template-columns: 1fr;
+   }
+ }
+
+ @media (max-width: 999px) {
+   #page-setup {
+     grid-template-columns: minmax(0, 1fr);
+     overflow: visible;
+   }
+   .setup-sidebar,
+   .setup-main {
+     height: auto;
+   }
+   .setup-nav {
+     flex-direction: row;
+     flex-wrap: wrap;
+   }
+ }
+
+ @media (max-width: 760px) {
+   .setup-content {
+     padding: var(--sp-2);
+   }
+ }
+
+ .notif {
+   overflow-wrap: anywhere;
+ }
+
+ .teams-sources {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .teams-selection {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-2);
+   margin-block: var(--sp-2);
+ }
+
+ .teams-selection label {
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 0;
+   flex: 1 1 160px;
+ }
+
+ .teams-selection input,
+ .teams-selection select {
+   width: 100%;
+   min-width: 0;
+ }
+
+ .ptrack .gate,
+ .pcard.gate {
+   border: 1px solid var(--warn-mark);
+   background: var(--surface-2);
+ }
+
+ .tchip {
+   display: inline-block;
+   border: 1px solid var(--line);
+   border-radius: var(--r-s);
+   padding: 0 var(--sp-1);
+   font-size: var(--fs-s);
+   width: fit-content;
+   overflow-wrap: anywhere;
+ }
+
+ .ptrack .tchip {
+   display: block;
+ }
+
+ .template-editor fieldset {
+   display: grid;
+   gap: var(--sp-2);
+   min-width: 0;
+ }
+
+ .template-editor label {
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 0;
+ }
+
+ .template-editor input,
+ .template-editor select {
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ .template-check {
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ @media (max-width: 480px) {
+   .pcards {
+     grid-template-columns: minmax(0, 1fr);
+   }
+   .pcard,
+   .ptrack li {
+     overflow-wrap: anywhere;
+     min-width: 0;
+   }
+ }
+
+ .ptrack b {
+   display: inline-grid;
+   place-items: center;
+   width: 22px;
+   height: 22px;
+   border: 1px solid var(--line);
+   border-radius: 50%;
+ }
+
+ .ptrack .gate b {
+   border-color: var(--warn-mark);
+   border-radius: var(--r-s);
+ }
+
+ .sessionform fieldset {
+   border: 0;
+   padding: 0;
+   margin: 0;
+   min-width: 0;
+ }
+
+ .sessionform label,
+ .sessionform input,
+ .sessionform select {
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ .repo-ownership {
+   margin-top: var(--sp-2);
+ }
+
+ .repo-ownership summary {
+   cursor: pointer;
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+
+ .repo-ownership .map-lens {
+   flex: none;
+   max-height: 420px;
+   margin-top: var(--sp-2);
+ }
+
+ /* long paths and URLs in the update log wrap instead of scrolling sideways */
+ .update-log-text {
+   overflow-wrap: anywhere;
+ }
+
+ .setup-repos {
+   display: grid;
+   gap: var(--sp-2);
+   align-content: start;
+ }
+
+ /* The return digest fills the work area; long refs wrap inside phone-width tiles. */
+ .away-digest {
+   overflow-y: auto;
+ }
+
+ .away-digest .stats {
+   grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
+ }
+
+ .away-digest .stat2 {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .modal .panel.awaypanel {
+   width: min(1120px, 100%);
+ }
+
+ .awaygrid {
+   display: grid;
+   grid-template-columns: repeat(3, minmax(0, 1fr));
+   gap: var(--sp-4);
+ }
+
+ .swlist {
+   display: grid;
+   gap: var(--sp-2);
+   margin-top: var(--sp-2);
+ }
+
+ .sw {
+   font-size: var(--fs-s);
+   display: flex;
+   gap: var(--sp-2);
+   align-items: flex-start;
+ }
+
+ /* a long label must not squeeze its checkbox */
+ .sw input {
+   flex: none;
+ }
+
+ .sw.locked {
+   color: var(--fg-2);
+ }
+
+ .sw.locked::before {
+   content: "Always";
+   font-size: var(--fs-s);
+   font-weight: 600;
+   color: var(--muted);
+   border: 1px solid var(--line-2);
+   border-radius: 4px;
+   padding: 0 var(--sp-1);
+   margin-top: var(--sp-1);
+   flex: none;
+ }
+
+ @media (max-width: 999px) {
+   .awaygrid {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
+
+ /* away modal: spacing the mockup set inline */
+ .awayctl {
+   margin-bottom: var(--sp-3);
+ }
+
+ .awaypanel h3.gap {
+   margin-top: var(--sp-3);
+ }
+
+ .awaypanel p.gap {
+   margin: var(--sp-2) 0;
+ }
+
+ .awaypanel .awaygrid > div {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .palette-modal {
+   place-items: start center;
+   padding-top: 12vh;
+ }
+
+ .modal .panel.palette {
+   width: min(640px, 100%);
+   max-height: 70vh;
+   box-shadow: var(--shadow);
+ }
+
+ .palette-input {
+   font: var(--fs) / var(--lh) var(--sans);
+   background: transparent;
+   color: var(--fg);
+   border: 0;
+   border-bottom: 1px solid var(--line);
+   padding: var(--sp-3) var(--sp-3);
+   outline: none;
+ }
+
+ .palette-input:focus-visible {
+   box-shadow: inset 0 -2px 0 var(--accent);
+ }
+
+ .palette-list {
+   list-style: none;
+   margin: 0;
+   padding: var(--sp-1);
+   overflow-y: auto;
+   min-height: 0;
+ }
+
+ .palette-row {
+   display: grid;
+   grid-template-columns: 76px minmax(0, 1fr) auto;
+   gap: var(--sp-2);
+   align-items: baseline;
+   padding: var(--sp-1) var(--sp-2);
+   border-radius: var(--r);
+   cursor: pointer;
+   font-size: var(--fs);
+ }
+
+ .palette-row.on {
+   background: var(--accent-soft);
+   box-shadow: inset 2px 0 0 var(--accent);
+ }
+
+ .palette-group {
+   font-size: var(--fs-s);
+   text-transform: uppercase;
+   letter-spacing: 0.06em;
+   color: var(--muted);
+ }
+
+ .palette-title {
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .palette-hint {
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   color: var(--muted);
+   max-width: 220px;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .palette-empty,
+ .palette-keys {
+   margin: 0;
+   padding: var(--sp-2) var(--sp-3);
+   font-size: var(--fs-s);
+ }
+
+ .palette-keys {
+   border-top: 1px solid var(--line);
+ }
+
+ /* dock: FLIGHT */
+ .dock {
+   min-height: 0;
+ }
+
+ .dock .dh {
+   flex: none;
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   padding: var(--panel-head-y) var(--sp-4);
+   border-bottom: 1px solid var(--line);
+   flex-wrap: wrap;
+ }
+
+ .dock .dh h2 {
+   margin: 0;
+   font: inherit;
+ }
+
+ .dockrail {
+   padding: var(--sp-2) 0;
+ }
+ .dockrail button {
+   display: grid;
+   justify-items: center;
+   gap: var(--sp-1);
+   width: 100%;
+   padding: var(--sp-2) 0;
+   white-space: normal;
+ }
+ .dockrail-name {
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+ .dockrail-caption {
+   font: var(--fs-s) / var(--lh-s) var(--sans);
+ }
+ .dock.collapsed .panel {
+   height: 100%;
+ }
+ .dock-summary {
+   flex: none;
+   max-height: 52%;
+   padding: var(--sp-4);
+   border-bottom: 1px solid var(--line);
+   display: grid;
+   gap: var(--sp-3);
+   overscroll-behavior: contain;
+   scrollbar-gutter: stable;
+ }
+ .dock-summary-state:empty {
+   display: none;
+ }
+ .dock-summary-state {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1);
+ }
+ .dock-summary h3 {
+   margin: 0;
+   font: 600 var(--fs-s) / var(--lh-s) var(--sans);
+ }
+ .dock-headline summary {
+   cursor: pointer;
+   min-height: 24px;
+ }
+ .dock-headline summary > span:first-child {
+   overflow-wrap: anywhere;
+ }
+ .dock-headline summary > span:last-child {
+   display: block;
+ }
+ .dock-headline p {
+   margin-top: var(--sp-2);
+   overflow-wrap: anywhere;
+ }
+ .dock-summary-item {
+   padding: var(--sp-2) 0;
+   border-bottom: 1px solid var(--line);
+ }
+ .dock-summary-item > .row {
+   display: flex;
+   gap: var(--sp-2);
+   flex-wrap: wrap;
+   align-items: center;
+ }
+ .dock-item-reason {
+   display: -webkit-box;
+   -webkit-line-clamp: 2;
+   -webkit-box-orient: vertical;
+   overflow: hidden;
+   overflow-wrap: anywhere;
+   margin: var(--sp-1) 0;
+   font: var(--fs-s) / var(--lh-s) var(--sans);
+ }
+ .dock-next {
+   display: grid;
+   justify-items: start;
+   gap: var(--sp-2);
+ }
+ .dock-next button {
+   white-space: normal;
+   text-align: left;
+ }
+ .dock-next a {
+   display: inline-flex;
+   min-height: 24px;
+   align-items: center;
+ }
+ .dock-summary button {
+   min-height: 24px;
+ }
+
+ .dock .dh .meta {
+   width: 100%;
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ /* Under the asks the log's top edge fades, so a line scrolled half out of view reads as the edge
+    of the scroll, not as text running behind the asks. */
+ .dwait + .dmsgs {
+   padding-top: var(--sp-4);
+   -webkit-mask-image: linear-gradient(to bottom, transparent 2px, var(--bg) 30px);
+   mask-image: linear-gradient(to bottom, transparent 2px, var(--bg) 30px);
+ }
+
+ /* What waits on the operator: an opaque block with the screen's one coloured edge. */
+ .dwait {
+   flex: none;
+   max-height: 40%;
+   overflow: auto;
+   overscroll-behavior: contain;
+   padding: 0 var(--sp-3) var(--sp-2);
+   border-bottom: 1px solid var(--line);
+   border-left: 2px solid var(--warn-mark);
+   background: color-mix(in srgb, var(--warn) 7%, var(--surface));
+   display: grid;
+   grid-template-columns: minmax(0, 1fr);
+   align-content: start;
+   gap: var(--sp-1);
+ }
+
+ .dwait .dwh {
+   position: sticky;
+   top: 0;
+   z-index: 1;
+   padding: var(--sp-2) 0 var(--sp-1);
+   color: var(--warn);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+   background: inherit;
+ }
+
+ .dask {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   min-width: 0;
+   min-height: 26px;
+   font-size: var(--fs-s);
+ }
+
+ /* only the ask's text gives way; the kind, who and Open stay whole on one line */
+ .dask > :not(.min0) {
+   flex: none;
+   white-space: nowrap;
+ }
+
+ .dask > button.sm {
+   padding: 0 var(--sp-2);
+ }
+
+ @media (max-width: 1199px) {
+   .dock {
+     display: none;
+     position: fixed;
+     top: 0;
+     right: 0;
+     bottom: 0;
+     width: min(420px, 100%);
+     z-index: 32;
+     padding: calc(var(--sp-2) + env(safe-area-inset-top, 0px))
+       max(var(--sp-2), env(safe-area-inset-right, 0px))
+       calc(var(--sp-2) + env(safe-area-inset-bottom, 0px)) var(--sp-2);
+   }
+   .dockscrim {
+     position: fixed;
+     inset: 0;
+     z-index: 31;
+     background: var(--scrim);
+   }
+ }
+
+ .dockbody {
+   display: contents;
+ }
+
+ /* Folded: the title row and the waiting count only; the conversation stays mounted so unread
+    replies still count. */
+ .dock.collapsed .dockbody,
+ .dock.collapsed .dh {
+   display: none;
+ }
+
+ .dolder {
+   align-self: center;
+   flex: none;
+ }
+
+ .helpb {
+   display: grid;
+   gap: var(--sp-2);
+ }
+
+ .flyout {
+   position: fixed;
+   top: 0;
+   right: 0;
+   bottom: 0;
+   width: min(540px, 100%);
+   z-index: 36;
+   padding: calc(var(--sp-2) + env(safe-area-inset-top, 0px))
+     max(var(--sp-2), env(safe-area-inset-right, 0px))
+     calc(var(--sp-2) + env(safe-area-inset-bottom, 0px)) var(--sp-2);
+ }
+
+ .flyout .panel {
+   height: 100%;
+   box-shadow: var(--shadow);
+ }
+
+ #dsBrief {
+   border-bottom: 1px solid var(--line);
+   padding-top: var(--sp-2);
+ }
+
+ #dsOpts {
+   flex-wrap: wrap;
+ }
+
+ #dsBrief blockquote {
+   margin: 0;
+   border-left: 2px solid var(--line);
+   padding-left: var(--sp-2);
+ }
+
+ /* overlays */
+ #toast {
+   position: fixed;
+   left: max(16px, env(safe-area-inset-left, 0px));
+   bottom: max(16px, env(safe-area-inset-bottom, 0px));
+   max-width: min(480px, calc(100% - 32px));
+   background: var(--surface);
+   border: 1px solid var(--accent);
+   border-radius: var(--r);
+   padding: var(--sp-2) var(--sp-3);
+   z-index: 40;
+   box-shadow: var(--shadow);
+ }
+
+ #toast:empty {
+   width: 1px;
+   height: 1px;
+   padding: 0;
+   border: 0;
+   overflow: hidden;
+   clip-path: inset(50%);
+ }
+
+ /* biome-ignore-all lint/style/noDescendingSpecificity: later rules override earlier ones by order here, as in hud.css */
+ /* telemetry */
+ #page-telemetry {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-2);
+   overflow: auto;
+ }
+
+ /* Telemetry's readouts sit in one instrument band, divided by hairlines rather than boxed apart. */
+ .kpis {
+   display: grid;
+   grid-template-columns: repeat(auto-fit, minmax(108px, 1fr));
+   gap: 0;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   overflow: hidden;
+   flex: none;
+ }
+
+ .kpis > .kpi {
+   border: 0;
+   border-radius: 0;
+   box-shadow:
+     1px 0 0 var(--line),
+     0 1px 0 var(--line);
+ }
+
+ .kpi {
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   padding: var(--sp-2) var(--sp-3);
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .kpi .v {
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+   line-height: var(--lh-title);
+   font-variant-numeric: tabular-nums;
+ }
+
+ .kpi .d {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+
+ @media (prefers-reduced-motion: no-preference) {
+   .kpi .v.kpi-change {
+     animation: kpi-change 450ms ease-out;
+   }
+   @keyframes kpi-change {
+     from {
+       opacity: 0.4;
+       transform: translateY(-2px);
+     }
+     to {
+       opacity: 1;
+       transform: translateY(0);
+     }
+   }
+ }
+
+ .ticket-bars {
+   max-height: 320px;
+   overflow-y: auto;
+ }
+
+ .ticket-bar-title {
+   /* two lines at most; the row's title attribute carries the full text */
+   display: -webkit-box;
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 2;
+   line-clamp: 2;
+   overflow: hidden;
+   white-space: normal;
+   overflow-wrap: anywhere;
+ }
+
+ .kpi.live .lbl::after {
+   content: " ● live";
+   color: var(--ok);
+   letter-spacing: 0;
+   text-transform: none;
+   font-weight: 500;
+ }
+
+ .grp {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-weight: 600;
+   letter-spacing: 0.16em;
+   text-transform: uppercase;
+   color: var(--muted);
+   margin-top: var(--sp-1);
+ }
+
+ .grp::after {
+   content: "";
+   flex: 1;
+   height: 1px;
+   background: linear-gradient(90deg, var(--line-2), transparent);
+ }
+
+ .tgrid {
+   display: grid;
+   grid-template-columns: repeat(2, minmax(0, 1fr));
+   gap: var(--sp-3);
+ }
+
+ .tgrid .wide {
+   grid-column: 1 / -1;
+ }
+
+ .chart {
+   position: relative;
+ }
+
+ .ubar {
+   display: flex;
+   height: 6px;
+   border-radius: 0;
+   overflow: hidden;
+   gap: var(--sp-1);
+   background: var(--line);
+ }
+
+ .ubar i {
+   display: block;
+   height: 100%;
+ }
+
+ .hrow.util {
+   grid-template-columns: minmax(0, 96px) minmax(0, 1fr) 48px;
+ }
+
+ /* cycle time: p50 beside the bar, then p85 and the ticket count on one line */
+ #tCycle .hrow {
+   grid-template-columns: minmax(0, 96px) minmax(0, 1fr) 56px 150px;
+ }
+
+ /* the registry's p50 over every size, above the per-size rows */
+ .tcycle-all {
+   margin: 0 0 var(--sp-2);
+ }
+
+ /* a long agent tag is cut at its column instead of running under the bar */
+ .hrow.util > :first-child {
+   min-width: 0;
+   overflow: hidden;
+   white-space: nowrap;
+   text-overflow: ellipsis;
+ }
+
+ .tnote {
+   margin-top: var(--sp-1);
+ }
+
+ #page-telemetry.refetching .kpis,
+ #page-telemetry.refetching .tgrid {
+   opacity: 0.6;
+ }
+
+ /* a tile whose figure is not stored */
+ .kpi .v.nt,
+ .stat2 b.nt {
+   font-size: var(--fs-s);
+   color: var(--muted);
+   font-weight: 400;
+ }
+
+ @media (max-width: 999px) {
