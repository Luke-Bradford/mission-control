+
+ /* Observed loops: one compact strip under the crew roster. */
+ .loops-strip {
+   flex: 0 0 auto;
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-2) var(--sp-3);
