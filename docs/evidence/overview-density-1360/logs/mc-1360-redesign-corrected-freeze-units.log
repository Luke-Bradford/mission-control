+ }
+
+ /* Setup › Loops: the operational chain scrolls as one drawing on narrow screens. */
+ .loop-show {
+   display: flex;
+   padding: var(--sp-1);
+   border: 1px solid var(--line);
+   border-radius: var(--r-s);
