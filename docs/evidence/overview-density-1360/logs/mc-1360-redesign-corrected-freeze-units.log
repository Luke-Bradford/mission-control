+
+ .pipeline-counts {
+   flex: 1;
+   margin: 0;
+   padding-bottom: var(--sp-1);
+   border-bottom: 2px solid var(--stage-colour);
+   line-height: var(--lh-s);
+   color: var(--fg-2);
