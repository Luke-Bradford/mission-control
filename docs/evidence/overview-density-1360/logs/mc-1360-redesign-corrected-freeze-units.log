+   border-bottom: 1px solid var(--line);
+ }
+
+ .tk-when {
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   color: var(--fg2);
+ }
+
+ .tk-line {
+   overflow-wrap: anywhere;
+   display: -webkit-box;
+   -webkit-line-clamp: 4;
+   -webkit-box-orient: vertical;
+   overflow: hidden;
+ }
+
+ .tk-more,
+ .tk-findings {
+   grid-column: 3;
+   font-size: var(--fs-s);
+ }
+
+ .tk-more > summary,
+ .tk-findings > summary {
+   min-height: 24px;
+   padding: var(--sp-1) 0;
+   cursor: pointer;
+ }
+
+ .tk-findings li {
+   padding: var(--sp-1) 0;
+   overflow-wrap: anywhere;
+ }
+
+ @media (max-width: 1100px) {
+   .tk-grid {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
