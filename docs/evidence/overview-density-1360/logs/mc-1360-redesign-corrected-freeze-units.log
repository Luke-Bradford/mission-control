+   overflow: hidden;
+   text-overflow: ellipsis;
+   min-width: 0;
+ }
+
+ .kanban {
+   flex: 1;
+   min-height: 0;
+   display: flex;
+   gap: var(--sp-2);
+   overflow-x: auto;
+   padding: var(--sp-1) var(--sp-1) var(--sp-1);
