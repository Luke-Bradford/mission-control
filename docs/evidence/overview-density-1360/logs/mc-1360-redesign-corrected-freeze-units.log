+   max-width: min(320px, calc(100vw - 28px));
+   padding: var(--sp-1) var(--sp-2);
+   color: var(--fg);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   line-height: var(--lh-micro);
+   text-align: left;
+   white-space: normal;
+   background: var(--surface-2);
+   border: 1px solid var(--line-2);
+   border-radius: 2px;
+   box-shadow: var(--shadow);
+   opacity: 0;
+   visibility: hidden;
+   pointer-events: none;
+ }
+
+ .mach-tooltip > span {
+   display: block;
+ }
+
+ .mach-btn:hover .mach-tooltip,
+ .mach-btn:focus-visible .mach-tooltip {
+   opacity: 1;
+   visibility: visible;
+ }
+
+ @media (min-width: 1280px) {
+   .top {
+     flex-wrap: nowrap;
+     gap: var(--sp-2);
+     padding-inline: var(--sp-3);
+   }
+   /* 1280 is in scope: the brand's tracking and the tabs' padding give the nine tabs and the
+      status meters room side by side, so no tab sits behind a sideways scroll */
+   .brand {
+     letter-spacing: 0.1em;
+   }
+   .tabs {
+     min-width: 0;
+   }
+   .tabs a {
+     gap: var(--sp-1);
+     padding-inline: var(--sp-1);
+     letter-spacing: 0.02em;
+   }
+   .top-status {
+     flex: 0 0 auto;
+     flex-wrap: nowrap;
+     gap: var(--sp-1);
+   }
+ }
+
+ .iconbtn {
+   position: relative;
+   padding: var(--sp-1) var(--sp-2);
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+ }
+
+ .iconbtn svg {
+   width: 16px;
+   height: 16px;
+   display: block;
+ }
+
+ .iconbtn .knob {
+   fill: var(--bg);
+ }
+
+ /* shell: work area plus FLIGHT's dock */
+ .shell {
+   flex: 1;
+   min-height: 0;
+   width: 100%;
+   padding: var(--shell-gutter);
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) 380px;
+   gap: var(--shell-gutter);
+ }
+
+ .app.dock-collapsed .shell:not(.shell-full) {
+   grid-template-columns: minmax(0, 1fr) var(--sp-7);
+ }
+
+ .app.dock-hidden .shell {
+   grid-template-columns: minmax(0, 1fr);
+ }
+
+ .shell.shell-full {
+   grid-template-columns: minmax(0, 1fr);
+ }
+
+ @media (max-width: 1199px) {
+   .shell,
+   .app.dock-hidden .shell {
+     grid-template-columns: minmax(0, 1fr);
+   }
+   .dock .panel {
+     box-shadow: var(--shadow);
+   }
+ }
+
+ .app.dock-hidden .dock {
+   display: none;
+ }
+
+ main {
+   min-width: 0;
+   min-height: 0;
+ }
+
+ main > section {
+   height: 100%;
+   min-height: 0;
+ }
+
+ /* A popped-out agent: the page fills the window. */
+ .app.popout main {
+   flex: 1;
+ }
+
+ /* panels */
+ .panel {
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   min-width: 0;
+   min-height: 0;
+   display: flex;
+   flex-direction: column;
+ }
+
+ .ph {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   padding: var(--panel-head-y) var(--sp-4);
+   border-bottom: 1px solid var(--line);
+   flex-wrap: wrap;
+   color: var(--fg-2);
+   background: linear-gradient(
+     to bottom,
+     color-mix(in srgb, var(--surface-2) 60%, transparent),
+     transparent
+   );
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-weight: 600;
+   letter-spacing: 0.12em;
+   text-transform: uppercase;
+ }
+
+ .ph h2 {
+   font: 600 var(--fs-panel) / var(--lh-panel) var(--sans);
+   letter-spacing: normal;
+   text-transform: none;
+ }
+
+ /* Column heads read as instrument labels everywhere (sizes and colours stay with the table rules). */
+ th {
+   font-family: var(--mono);
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+ }
+
+ .pb {
+   padding: var(--sp-4);
+   min-width: 0;
+ }
+
+ .scroll {
+   overflow: auto;
+   min-height: 0;
+ }
+
+ @media (max-width: 390px) {
+   .top {
+     align-items: stretch;
+     overflow-x: clip;
+   }
+   .top-status {
+     display: grid;
+     grid-template-columns: repeat(2, minmax(0, 1fr));
+     width: 100%;
+   }
+   .top-status > * {
+     min-width: 0;
+   }
+   .top-status .usage {
+     grid-column: 1 / -1;
+   }
+   #sess {
+     width: 100%;
+     max-width: none;
+   }
+ }
+
+ .dock-unread {
+   background: var(--warn-mark);
+   color: var(--bg);
+   border-radius: 9px;
+   padding: 0 var(--sp-1);
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+ }
+
+ .iconbtn .dock-unread {
+   position: absolute;
+   top: -4px;
+   right: -4px;
+ }
+
+ table {
+   border-collapse: collapse;
+   width: 100%;
+   font-size: var(--fs-s);
+ }
+
+ th,
+ td {
+   text-align: left;
+   padding: var(--table-cell-y) var(--sp-2) var(--table-cell-y) 0;
+   border-top: 1px solid var(--line);
+   white-space: nowrap;
+ }
+
+ tr {
+   height: var(--table-row);
+ }
+
+ /* The roster's shared grid rows use the same density as semantic tables. */
+ .app .trow {
+   min-height: var(--table-row);
+   padding-block: var(--table-cell-y);
+ }
+
+ th {
+   color: var(--muted);
+   font-weight: 500;
+   font-size: var(--fs-s);
+   border-top: 0;
+ }
+
+ /* Kept out of the normal tab sequence until a keyboard user asks to bypass the chrome. */
+ .skip-link {
+   position: fixed;
+   top: 8px;
+   left: 8px;
+   z-index: 10;
+   padding: var(--sp-1) var(--sp-2);
+   background: var(--surface);
+   border: 1px solid var(--accent);
+   color: var(--fg);
+   transform: translateY(-150%);
+ }
+
+ .skip-link:focus {
+   transform: translateY(0);
+ }
+
+ /* build status overlay */
+ .bs {
+   font-size: var(--fs-s);
+   font-weight: 600;
+   border-radius: 4px;
+   padding: 0 var(--sp-1);
+   margin-left: var(--sp-1);
+   cursor: help;
+   white-space: nowrap;
+   border: 1px dashed currentColor;
+   line-height: var(--lh-s);
+ }
+
+ .bs-proven {
+   color: var(--ok);
+ }
+
+ .bs-build {
+   color: var(--fg-2);
+ }
+
+ .bs-later {
+   color: var(--accent);
+ }
+
+ .bs-check {
+   color: var(--warn);
+ }
+
+ .app.bs-on .phase {
+   display: none;
+ }
+
+ .bslegend {
+   display: inline-flex;
+   gap: var(--sp-2);
+   flex-wrap: wrap;
+   align-items: center;
+ }
+
+ kbd {
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   border: 1px solid var(--line-2);
+   border-bottom-width: 2px;
+   border-radius: 4px;
+   padding: 0 var(--sp-1);
+   margin-right: var(--sp-1);
+ }
+
+ @media (min-width: 1000px) and (min-height: 560px) {
+   body {
+     overflow: hidden;
+   }
+   /* Where even the panels' minimum heights do not fit (the Agent page near 1000×560), the work
+      area scrolls rather than cutting the lower panels off. */
+   main {
+     overflow: auto;
+   }
+ }
+
+ @media (max-width: 1199px) {
+   .app.dock-open .dock,
+   .app.dock-hidden.dock-open .dock {
+     display: block;
+   }
+ }
+
+ @media (max-width: 999px), (max-height: 559px) {
+   #root,
+   .app {
+     height: auto;
+     min-height: 100%;
+   }
+   .shell {
+     flex: none;
+   }
+   main > section {
+     height: auto;
+   }
+ }
+
+ @media (max-width: 760px) {
+   .top {
+     padding: var(--sp-2) var(--sp-3);
+     gap: var(--sp-2) var(--sp-3);
+   }
+   .top-status {
+     position: relative;
+     width: 100%;
+     margin-left: 0;
+   }
+   .mach-btn {
+     position: static;
+   }
+   .mach-tooltip {
+     top: calc(100% + 6px);
+     right: 0;
+     left: 0;
+     width: auto;
+     max-width: none;
+   }
+   .shell {
+     padding: var(--sp-2);
+   }
+   /* every tab visible: wrap rather than hide Telemetry behind a sideways scroll */
+   .tabs {
+     flex-wrap: wrap;
+     overflow-x: visible;
+   }
+ }
+
+ .live-indicator {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   white-space: nowrap;
+   font-size: var(--fs-s);
+   color: var(--ok);
+ }
+
+ .live-indicator.connecting {
+   color: var(--warn);
+ }
+
+ .live-indicator.down {
+   color: var(--crit);
+ }
+
+ .live-indicator i {
+   width: 6px;
+   height: 6px;
+   border-radius: 50%;
+   background: currentColor;
+ }
+
+ .live-indicator.fresh i {
+   animation: live-pulse 2s ease-in-out infinite;
+ }
+
+ @keyframes live-pulse {
+   50% {
+     opacity: 0.35;
+   }
+ }
+
+ @media (prefers-reduced-motion: reduce) {
+   .live-indicator.fresh i {
+     animation: none;
+   }
+ }
+
+ .rename-editor {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-1);
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ .rename-editor label {
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ .rename-editor input {
+   min-width: 0;
+   width: 16ch;
+   max-width: 100%;
+ }
+
+ .rename-editor [role="alert"] {
+   overflow-wrap: anywhere;
+   max-width: 100%;
+ }
+
+ .account-chooser {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-1);
+   flex-basis: 100%;
+   min-width: 0;
+   max-width: 100%;
+   overflow-wrap: anywhere;
+ }
+
+ .account-chooser label,
+ .account-chooser select {
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ .account-chooser select {
+   width: 24ch;
+ }
+
+ .agent-v2-identity {
+   padding: var(--sp-4);
+ }
+ .agent-v2-idrow {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-3);
+   flex-wrap: wrap;
+ }
+ .agent-v2-idrow h2 {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   font: 700 var(--fs-title) / var(--lh-title) var(--display);
+ }
+ .agent-v2-idrow h2 i {
+   width: var(--sp-3);
+   height: var(--sp-3);
+   border-radius: var(--r-s);
+ }
+ .agent-v2-state {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   min-width: 0;
+   max-width: min(48%, 640px);
+   padding: var(--sp-1) var(--sp-2);
+   border: 1px solid var(--line-2);
+   border-radius: var(--r);
+   font-size: var(--fs-s);
+ }
+ .agent-v2-state.parked,
+ .agent-v2-state.blocked,
+ .agent-v2-state.waiting {
+   color: var(--warn);
+   border-color: var(--warn);
+   background: var(--warn-soft);
+ }
+ .agent-v2-state.error,
+ .agent-v2-state.stalled {
+   color: var(--crit);
+   border-color: var(--crit);
+ }
+ .agent-v2-actions {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   margin-left: auto;
+ }
+ .agent-v2-actions details {
+   position: relative;
+ }
+ .agent-v2-actions summary {
+   min-height: 28px;
+   min-width: 48px;
+   padding: var(--sp-1) var(--sp-3);
+   border: 1px solid var(--line-2);
+   border-radius: var(--r);
+   background: var(--surface-2);
+   cursor: pointer;
+   list-style: none;
+ }
+ .agent-v2-menu {
+   position: absolute;
+   right: 0;
+   top: calc(100% + var(--sp-1));
+   z-index: 5;
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 200px;
+   padding: var(--sp-2);
+   background: var(--surface);
+   border: 1px solid var(--line-2);
+   box-shadow: 0 4px 12px var(--bg);
+ }
+ .agent-v2-meta {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-3);
+   flex-wrap: wrap;
+   margin-top: var(--sp-2);
+   font-size: var(--fs-s);
+ }
+ .agent-v2-meta .mono {
+   overflow-wrap: anywhere;
+ }
+ .agent-v2-meta a,
+ .agent-v2 a {
+   min-height: 24px;
+   display: inline-flex;
+   align-items: center;
+ }
+ .agent-v2-next {
+   display: flex;
+   flex-direction: row;
+   align-items: center;
+   gap: var(--sp-3);
+   padding: var(--sp-3) var(--sp-4);
+   border-left: 3px solid var(--warn);
+ }
+ .agent-v2-next > div {
+   flex: 1;
+   min-width: 0;
+ }
+ .agent-v2-next .btn {
+   white-space: nowrap;
+ }
+ .agent-v2-stats {
+   display: grid;
+   grid-template-columns: repeat(5, minmax(0, 1fr));
+   gap: var(--sp-3);
+ }
+ .agent-v2-stat {
+   padding: var(--sp-3) var(--sp-4);
+   min-width: 0;
+ }
+ .agent-v2-stat h3 {
+   font: 500 var(--fs-micro) / var(--lh-micro) var(--mono);
+   text-transform: uppercase;
+   letter-spacing: 0.06em;
+   color: var(--muted);
+ }
+ .agent-v2-stat > p {
+   margin: var(--sp-1) 0;
+   font: 600 var(--fs-title) / var(--lh-title) var(--display);
+   font-variant-numeric: tabular-nums;
+ }
+ .agent-v2-stat > div {
+   display: flex;
+   flex-direction: column;
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+   color: var(--fg-2);
+ }
+ .agent-v2-stat > div span {
+   overflow-wrap: anywhere;
+ }
+ .agent-v2-steps {
+   display: grid;
+   grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
+   list-style: none;
+   padding: 0;
+   margin: 0;
+   max-height: 240px;
+   overflow: auto;
+ }
+ .agent-v2-steps > li {
+   padding: var(--sp-2) var(--sp-4);
+   border-right: 1px solid var(--line);
+   min-width: 0;
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-1);
+ }
+ .agent-v2-steps .done > b {
+   color: var(--ok);
+ }
+ .agent-v2-steps .held {
+   background: var(--warn-soft);
+   box-shadow: inset 0 2px var(--warn);
+ }
+ .agent-v2-steps .held > b {
+   color: var(--warn);
+ }
+ .agent-v2-steps .current > b {
+   color: var(--accent);
+ }
+ .agent-v2-steps > li > span {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+ .agent-v2-steps .agent-v2-step-time {
+   font: 400 var(--fs-micro) / var(--lh-micro) var(--mono);
+   color: var(--muted);
+ }
+ .agent-v2-columns {
+   display: grid;
+   grid-template-columns: minmax(0, 1.6fr) minmax(360px, 1fr);
+   gap: var(--sp-3);
+   align-items: start;
+ }
+ .agent-v2-left,
+ .agent-v2-right {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-3);
+   min-width: 0;
+ }
+ .agent-v2-story {
+   display: grid;
+   grid-template-columns: repeat(2, minmax(0, 1fr));
+   gap: var(--sp-4);
+   font-size: var(--fs-s);
+ }
+ .agent-v2-story h3 {
+   font-size: var(--fs-s);
+   margin-bottom: var(--sp-2);
+ }
+ .agent-v2-story p {
+   overflow-wrap: anywhere;
+ }
+ .agent-v2-story details > ol,
+ .agent-v2-story details > ul {
+   max-height: 200px;
+   overflow: auto;
+   padding-left: var(--sp-4);
+   margin: var(--sp-2) 0;
+ }
+ .agent-v2 summary {
+   min-height: 24px;
+   cursor: pointer;
+ }
+ .agent-v2-deliverables,
+ .agent-v2-related {
+   list-style: none;
+   padding: 0;
+   margin: 0;
+   max-height: 240px;
+   overflow: auto;
+   scrollbar-gutter: stable;
+ }
+ .agent-v2-deliverables > li {
+   min-height: 40px;
+   padding: var(--sp-2) var(--sp-4);
+   border-bottom: 1px solid var(--line);
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+ }
+ .agent-v2-deliverables > li > span {
+   font: 400 var(--fs-micro) / var(--lh-micro) var(--mono);
+   color: var(--muted);
+   min-width: 48px;
+   text-transform: uppercase;
+ }
+ .agent-v2-deliverables a {
+   overflow-wrap: anywhere;
+   min-width: 0;
+ }
+ .agent-v2-related {
+   padding: var(--sp-2) var(--sp-4);
+ }
+ .agent-v2-related li {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: baseline;
+   min-height: 28px;
+ }
+ .agent-v2-related li > div {
+   display: flex;
+   flex-direction: column;
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+ .agent-v2-related li span {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+ .agent-v2 #streamP {
+   height: 440px;
+   min-height: 320px;
+ }
+ .agent-v2 #sideP {
+   max-height: 440px;
+   min-height: 160px;
+ }
+ .agent-v2-history {
+   padding: var(--sp-3) var(--sp-4);
+ }
+ .agent-v2-history #loopP {
+   max-height: 480px;
+ }
+ #page-agent.agent-v2 {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-3);
+   min-height: 0;
+   height: 100%;
+   overflow-y: auto;
+   padding-bottom: var(--sp-4);
+ }
+ @media (max-width: 1350px) {
+   .agent-v2-columns {
+     grid-template-columns: minmax(0, 1.45fr) minmax(360px, 1fr);
+   }
+   .agent-v2-stats {
+     gap: var(--sp-2);
+   }
+   .agent-v2-stat {
+     padding: var(--sp-3);
+   }
+ }
+
+ #page-agent.agent-v2 > * {
+   flex-shrink: 0;
+ }
+
+ .event-mark {
+   margin-right: var(--sp-1);
+ }
+
+ /* biome-ignore-all lint/style/noDescendingSpecificity: later rules override earlier ones by order here, as in hud.css */
+ .tdot {
+   position: relative;
+   z-index: 1;
+   width: 24px;
+   height: 24px;
+   border-radius: 50%;
+   display: inline-grid;
+   place-items: center;
+   font-size: var(--fs-s);
+   font-weight: 600;
+   background: var(--surface-2);
+   color: var(--muted);
+   border: 2px solid var(--line-2);
+   flex: none;
+ }
+
+ .tdot.sm {
+   width: 20px;
+   height: 20px;
+   font-size: var(--fs-s);
+ }
+
+ .vsteps {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr);
+ }
+
+ .vstep {
+   position: relative;
+   padding: 0 0 var(--sp-3) var(--sp-6);
+ }
+
+ .vstep::before {
+   content: "";
+   position: absolute;
+   left: 11px;
+   top: 26px;
+   bottom: 0;
+   width: 2px;
+   background: var(--line-2);
+ }
+
+ .vstep:last-child::before {
+   display: none;
+ }
+
+ .vstep.done::before {
+   background: var(--fg-2);
+ }
+
+ .vstep .tdot {
+   position: absolute;
+   left: 0;
+   top: 0;
+ }
+
+ .vstep.done .tdot {
+   background: var(--fg-2);
+   color: var(--surface);
+   border-color: var(--fg-2);
+ }
+
+ .vstep.cur .tdot {
+   background: var(--ok-soft);
+   color: var(--ok);
+   border-color: var(--ok);
+ }
+
+ .vstep.warn .tdot {
+   background: var(--warn-soft);
+   color: var(--warn);
+   border-color: var(--warn-mark);
+ }
+
+ .vstep.fail .tdot {
+   background: var(--crit-soft);
+   color: var(--crit);
+   border-color: var(--crit);
+ }
+
+ .vhead {
+   all: unset;
+   box-sizing: border-box;
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto;
+   align-items: center;
+   gap: var(--sp-2);
+   width: 100%;
+   min-height: 24px;
+   cursor: pointer;
+ }
+
+ .vhead:focus-visible {
+   outline: 2px solid var(--accent);
+   outline-offset: 2px;
+   border-radius: 2px;
+ }
+
+ .vname {
+   font-weight: 500;
+   display: inline-flex;
+   gap: var(--sp-1);
+   align-items: center;
+ }
+
+ .vmeta {
+   font-size: var(--fs-s);
+   color: var(--muted);
+   font-variant-numeric: tabular-nums;
+ }
+
+ .vfail {
+   font-size: var(--fs-s);
+   color: var(--crit);
+ }
+
+ .vrule {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+
+ .atts {
+   margin-top: var(--sp-1);
+   display: grid;
+   gap: var(--sp-1);
+   border-left: 2px solid var(--line);
+   padding-left: var(--sp-2);
+ }
+
+ .att {
+   display: grid;
+   grid-template-columns: 56px minmax(0, 1fr) auto 34px;
+   gap: var(--sp-1);
+   font-size: var(--fs-s);
+   align-items: baseline;
+ }
+
+ .mbar {
+   display: block;
+   height: 6px;
+   border-radius: 3px;
+   background: var(--surface-2);
+   overflow: hidden;
+ }
+
+ .mbar i {
+   display: block;
+   height: 100%;
+   border-radius: 3px;
+   background: var(--fg-2);
+ }
+
+ .tlrow {
+   display: grid;
+   grid-template-columns: 84px minmax(0, 1fr);
+   gap: var(--sp-2);
+   align-items: center;
+   padding: var(--sp-1) 0;
+   font-size: var(--fs-s);
+ }
+
+ .tlbars {
+   position: relative;
+   height: 14px;
+   background: var(--surface-2);
+   border-radius: 2px;
+ }
+
+ .tlbars i {
+   position: absolute;
+   top: 2px;
+   bottom: 2px;
+   border-radius: 3px;
+   min-width: 4px;
+ }
+
+ .tl-pass {
+   background: var(--fg-2);
+ }
+
+ .tl-fail {
+   background: var(--crit);
+ }
+
+ .tl-fix {
+   background: var(--accent);
+ }
+
+ .tl-run {
+   background: var(--ok);
+ }
+
+ .tl-wait {
+   background: var(--warn-mark);
+ }
+
+ .check {
+   display: grid;
+   grid-template-columns: 70px minmax(0, 1fr);
+   gap: var(--sp-2);
+   padding: var(--sp-1) 0;
+   font-size: var(--fs-s);
+   align-items: baseline;
+ }
+
+ #sideBody .check > :last-child {
+   overflow-wrap: anywhere;
+ }
+
+ .ck-pass,
+ .ck-done {
+   color: var(--ok);
+ }
+
+ .ck-fail {
+   color: var(--crit);
+ }
+
+ .ck-run,
+ .ck-in_progress {
+   color: var(--accent);
+ }
+
+ .ck-wait,
+ .ck-pending {
+   color: var(--muted);
+ }
+
+ .qi {
+   display: grid;
+   grid-template-columns: 16px minmax(0, 1fr) auto;
+   gap: var(--sp-2);
+   padding: var(--sp-1) 0;
+   align-items: center;
+   font-size: var(--fs-s);
+ }
+
+ .vnow,
+ .vhold > span:last-child {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .vnow,
+ .vholdtext {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto;
+   align-items: center;
+   gap: var(--sp-2);
+ }
+
+ .vnow {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+
+ .vdetail {
+   margin: var(--sp-1) 0;
+   padding: var(--sp-2);
+   max-height: 40vh;
+   overflow: auto;
+   white-space: pre-wrap;
+   overflow-wrap: anywhere;
+   font: inherit;
+   font-size: var(--fs-s);
+   background: var(--surface-2);
+   border-radius: var(--r);
+ }
+
+ @media (prefers-reduced-motion: no-preference) {
+   .vstep.cur .tdot {
+     animation: po 3.2s ease-in-out infinite;
+   }
+ }
+
+ .vhold {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   margin-bottom: var(--sp-2);
+   padding: var(--sp-1) var(--sp-2);
+   border-radius: var(--r);
+   color: var(--warn);
+   background: var(--warn-soft);
+ }
+
+ .vhold .tdot {
+   background: var(--warn-soft);
+   color: var(--warn);
+   border-color: var(--warn-mark);
+ }
+
+ .idrow .big .rt {
+   font-family: var(--sans, inherit);
+   font-size: var(--fs-s);
+   font-weight: 400;
+   color: var(--fg-2);
+ }
+
+ /* agent */
+ #page-agent {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-2);
+ }
+
+ .picker {
+   display: flex;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+ }
+
+ .picker button {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-2);
+   background: var(--surface);
+   border-color: var(--line);
+ }
+
+ .banner {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: center;
+   flex-wrap: wrap;
+   padding: var(--sp-2) var(--sp-3);
+   border: 1px solid var(--line);
+   box-shadow: inset 2px 0 0 var(--warn-mark);
+   background: linear-gradient(90deg, var(--warn-soft), transparent 70%), var(--surface);
+   color: var(--warn);
+   border-radius: var(--r);
+ }
+
+ .ahead .doing {
+   margin: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .idrow {
+   display: flex;
+   gap: var(--sp-2) var(--sp-3);
+   align-items: center;
+   flex-wrap: wrap;
+ }
+
+ .idrow .big {
+   min-width: 0;
+   max-width: 100%;
+   overflow-wrap: anywhere;
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+   letter-spacing: 0.02em;
+   line-height: var(--lh-title);
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-2);
+ }
+
+ .idrow .big i {
+   width: 12px;
+   height: 12px;
+   border-radius: 3px;
+   background: var(--c);
+ }
+
+ .idrow .chips {
+   display: flex;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ /* a long chip (a branch, an area) is cut at the row's width rather than widening the page */
+ .idrow .chips span {
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   color: var(--fg-2);
+   background: var(--surface-2);
+   border-radius: 2px;
+   padding: 0 var(--sp-2);
+   white-space: nowrap;
+   max-width: 100%;
+   overflow: hidden;
+   text-overflow: ellipsis;
+ }
+
+ .idrow .ctl {
+   min-width: 0;
+   max-width: 100%;
+   margin-left: auto;
+   display: flex;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+ }
+
+ .tiles2 {
+   display: grid;
+   grid-template-columns: repeat(auto-fit, minmax(112px, 1fr));
+   gap: var(--sp-2);
+ }
+
+ .tile2 {
+   background: var(--surface-2);
+   border-radius: var(--r);
+   padding: var(--sp-2) var(--sp-2);
+   display: grid;
+   gap: var(--sp-1);
+   align-content: start;
+   min-width: 0;
+ }
+
+ .tile2 .v {
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+   line-height: var(--lh-title);
+   white-space: nowrap;
+   overflow: hidden;
+   text-overflow: ellipsis;
+ }
+
+ .tile2 .v small {
+   font-family: var(--sans);
+   font-size: var(--fs-s);
+   font-weight: 400;
+   color: var(--fg-2);
+   margin-left: var(--sp-1);
+ }
+
+ .tile2 .d {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+   min-width: 0;
+ }
+
+ .tile2.now {
+   grid-column: span 2;
+ }
+
+ /* A long ticket title would make the head tall enough to push the side panels off the window. */
+ .tile2 .nowt {
+   display: -webkit-box;
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 2;
+   line-clamp: 2;
+   overflow: hidden;
+ }
+
+ .tile2 .nowdoing {
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .ctxbar {
+   display: flex;
+   height: 8px;
+   gap: var(--sp-1);
+   border-radius: 2px;
+   overflow: hidden;
+   background: var(--surface);
+   margin: var(--sp-1) 0;
+ }
+
+ .ctxbar i {
+   display: block;
+   height: 100%;
+   background: var(--seat-1);
+ }
+
+ .ctxbar.seg i.sys {
+   background: var(--seat-5);
+ }
+
+ .ctxbar.seg i.tools {
+   background: var(--seat-4);
+ }
+
+ .ctxbar.seg i.msgs {
+   background: var(--seat-1);
+ }
+
+ .ctxbar.seg i.buf {
+   background: var(--line-2);
+ }
+
+ .ctxbar.hi i {
+   background: var(--warn-mark);
+ }
+
+ .ctxbar.full i {
+   background: var(--crit);
+ }
+
+ .agrid {
+   flex: 1;
+   min-height: 0;
+   display: grid;
+   grid-template-columns: minmax(0, 1.7fr) minmax(320px, 1fr);
+   gap: var(--sp-3);
+ }
+
+ .livecall {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: baseline;
+   padding: var(--sp-2) var(--sp-3);
+   border-top: 1px solid var(--line);
+   border-bottom: 1px solid var(--line);
+   background: var(--surface-2);
+   font-size: var(--fs-s);
+ }
+
+ .livecall.stuck {
+   background: var(--warn-soft);
+   color: var(--warn);
+ }
+
+ .livecall .t {
+   font-family: var(--mono);
+   flex: 1;
+   min-width: 0;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .ev {
+   display: grid;
+   grid-template-columns: 44px 58px minmax(0, 1fr);
+   gap: var(--sp-2);
+   padding: var(--sp-1) var(--sp-3);
+   border-top: 1px solid var(--line);
+   font-size: var(--fs-s);
+   align-items: baseline;
+ }
+
+ .ev .at {
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .ev .who {
+   color: var(--muted);
+   font-size: var(--fs-s);
+   font-weight: 500;
+ }
+
+ .ev .txt {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .ev.think .txt {
+   color: var(--think);
+   font-style: italic;
+ }
+
+ .ev.tool .txt {
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+ }
+
+ .ev.tool .tres {
+   color: var(--muted);
+ }
+
+ .ev.tool summary {
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .ev.tool .tn {
+   font-weight: 600;
+ }
+
+ .ev.you .who,
+ .ev.you .txt {
+   color: var(--accent);
+ }
+
+ .ev.ask .who,
+ .ev.guard .who,
+ .ev.guard .txt {
+   color: var(--warn);
+ }
+
+ .ev.sys .txt {
+   color: var(--muted);
+ }
+
+ .ev details summary {
+   cursor: pointer;
+   list-style: none;
+ }
+
+ .ev details pre {
+   margin: var(--sp-1) 0 0;
+   white-space: pre-wrap;
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+ }
+
+ .side > #loopP {
+   flex: 1.25 1 0;
+   min-height: 260px;
+ }
+
+ .side > #sideP {
+   flex: 1 1 0;
+   min-height: 200px;
+ }
+
+ .subrow {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto;
+   gap: var(--sp-1) var(--sp-2);
+   padding: var(--sp-2) 0;
+   border-top: 1px solid var(--line);
+   font-size: var(--fs-s);
+ }
+
+ .subrow:first-child {
+   border-top: 0;
+ }
+
+ .f {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto auto;
+   gap: var(--sp-2);
+   padding: var(--sp-1) 0;
+   font-size: var(--fs-s);
+ }
+
+ /* A file row is a button: it opens the file's diff below the list. */
+ button.f {
+   width: 100%;
+   text-align: left;
+   background: transparent;
+   border: 0;
+   border-radius: 0;
+   color: inherit;
+   white-space: normal;
+   line-height: inherit;
+ }
+
+ button.f:hover,
+ button.f[aria-pressed="true"] {
+   color: var(--accent);
+ }
+
+ .fdiff {
+   margin-top: var(--sp-2);
+ }
+
+ .fdiff-h {
+   display: flex;
+   align-items: center;
+   justify-content: space-between;
+   gap: var(--sp-2);
+ }
+
+ /* Agent page: the Runs list where the mockup's Loop panel sits */
+ .runrow {
+   display: grid;
+   grid-template-columns: 32px 84px 44px minmax(52px, 1fr) 44px 56px;
+   gap: var(--sp-1) var(--sp-1);
+   white-space: nowrap;
+   align-items: center;
+   padding: var(--sp-1) 0;
+   border-top: 1px solid var(--line);
+ }
+
+ .runrow.head {
+   border-top: 0;
+ }
+
+ .runrow .right {
+   text-align: right;
+ }
+
+ .runrow .rticket {
+   grid-column: 2 / -1;
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-1) var(--sp-1);
+ }
+
+ .runrow .rticket > * {
+   flex: none;
+ }
+
+ .run-checklist {
+   display: grid;
+   gap: var(--sp-1);
+   margin: 0;
+   padding: 0;
+   list-style: none;
+ }
+
+ .run-checklist > li {
+   display: grid;
+   grid-template-columns: 16px minmax(0, 1fr) auto;
+   gap: var(--sp-1);
+   align-items: start;
+   padding-bottom: var(--sp-1);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .run-checklist-note,
+ .run-checklist-next {
+   display: block;
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+
+ /* the whole of a long reason: wrapped, and bounded so one refusal cannot fill the panel */
+ .run-checklist-full {
+   display: block;
+   max-height: 12em;
+   overflow: auto;
+   margin-top: var(--sp-1);
+   white-space: pre-wrap;
+   overflow-wrap: anywhere;
+ }
+
+ .run-checklist-total {
+   color: var(--fg-2);
+ }
+
+ /* The Run Trace panel fills the page and scrolls its own body, so a trace taller than the window is
+    reached by scrolling the panel, never cut off. Head, sections and the right column share the
+    body's 14px gutter and the shell's 14px gap. */
+ .trace-panel {
+   flex: 1 1 auto;
+ }
+
+ .run-trace {
+   max-width: none;
+ }
+
+ .trace-head {
+   margin: var(--sp-2) 0 var(--sp-3);
+ }
+
+ .trace-head .eyebrow {
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.12em;
+   color: var(--muted);
+ }
+
+ .trace-head h1 {
+   margin: var(--sp-1) 0;
+   font-size: var(--fs-title);
+ }
+
+ /* rows size to their content; each column's sections stack from the top */
+ .trace-grid {
+   display: grid;
+   grid-template-columns: minmax(0, 3fr) minmax(220px, 2fr);
+   grid-auto-rows: auto;
+   align-items: start;
+   gap: var(--sp-3);
+ }
+
+ .trace-section {
+   padding: var(--sp-3) 0;
+   border-top: 1px solid var(--line);
+ }
+
+ .trace-section h2 {
+   margin: 0 0 var(--sp-2);
+   font-size: var(--fs);
+ }
+
+ .trace-section p,
+ .trace-event {
+   margin: var(--sp-1) 0;
+ }
+
+ @media (max-width: 700px) {
+   .trace-grid {
+     grid-template-columns: 1fr;
+   }
+ }
+
+ /* the ticket's title takes what is left of the first line (never under 8ch) and is cut with an
+    ellipsis; PR chips that do not fit after it move to the next line */
+ .runrow .rticket > .rtitle {
+   flex: 1 1 0;
+   min-width: 8ch;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ /* The side panel is 320px at its narrowest (1200-1439 with FLIGHT's dock). Under the six
+    columns' minimum (32 + 84 + 44 + 52 + 44 + 56 + 5 × 4 = 332px) a run row drops Started and
+    Tokens, as it does at 390. */
+ #loopBody {
+   container: runs / inline-size;
+ }
+
+ @container runs (width < 332px) {
+   .runrow {
+     grid-template-columns: 32px 84px minmax(0, 1fr) 56px;
+   }
+   .runrow > :nth-child(3),
+   .runrow > :nth-child(5) {
+     display: none;
+   }
+ }
+
+ /* the summary is a button holding two lines; the full text opens on click, Enter or Space (and is the title on hover) */
+ .runrow button.rsummary {
+   grid-column: 2 / -1;
+   min-width: 0;
+   display: block;
+   width: 100%;
+   padding: 0;
+   border: 0;
+   border-radius: 0;
+   background: none;
+   line-height: inherit;
+   text-align: left;
+   white-space: normal;
+ }
+
+ .runrow .rsummary .rtext {
+   display: -webkit-box;
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 2;
+   line-clamp: 2;
+   overflow: hidden;
+   overflow-wrap: anywhere;
+ }
+
+ .runrow .rsummary:focus-visible {
+   outline: 2px solid var(--accent);
+   outline-offset: 1px;
+ }
+
+ .runrow .rsummary.open .rtext {
+   display: block;
+   -webkit-line-clamp: unset;
+   line-clamp: unset;
+ }
+
+ .msg.sys .body {
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ @media (max-width: 999px), (max-height: 559px) {
+   .side > #sideP,
+   .side > #loopP {
+     flex: none;
+     min-height: 0;
+   }
+   #sideBody {
+     max-height: 460px;
+   }
+ }
+
+ @media (max-width: 999px) {
+   .agrid {
+     grid-template-columns: minmax(0, 1fr);
+   }
+   .tile2.now {
+     grid-column: auto;
+   }
+ }
+
+ @media (max-width: 760px) {
+   .runrow {
+     grid-template-columns: 32px 84px minmax(0, 1fr) 56px;
+   }
+   .runrow > :nth-child(3),
+   .runrow > :nth-child(5) {
+     display: none;
+   }
+   .ev {
+     grid-template-columns: 40px minmax(0, 1fr);
+   }
+   .ev .who {
+     display: none;
+   }
+ }
+
+ .queue-focus {
+   flex-wrap: wrap;
+   overflow-wrap: anywhere;
+ }
+
+ .queue-focus form {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-2);
+   min-width: 0;
+   width: 100%;
+ }
+
+ .queue-focus input {
+   min-width: 0;
+   width: 100%;
+ }
+
+ /* a step still to come reads as muted: its rule is all it has */
+ .vstep.todo .vrule {
+   color: var(--muted);
+ }
+
+ .agent-handoff {
+   flex: none;
+   min-width: 0;
+ }
+ .agent-handoff > summary {
+   min-height: 32px;
+   padding: var(--sp-2) var(--sp-3);
+   cursor: pointer;
+   font-size: var(--fs-s);
+   overflow-wrap: anywhere;
+ }
+ .agent-handoff > summary span {
+   margin-left: var(--sp-3);
+   color: var(--muted);
+ }
+ .handoff-body {
+   padding: var(--sp-3);
+   max-height: 300px;
+   overflow: auto;
+   font-size: var(--fs-s);
+   overflow-wrap: anywhere;
+ }
+ .handoff-body p {
+   margin: 0 0 var(--sp-2);
+ }
+ .handoff-body h3 {
+   margin: var(--sp-3) 0 var(--sp-1);
+   font-size: var(--fs-s);
+ }
+ .handoff-body ul {
+   margin: 0;
+   padding-left: var(--sp-4);
+ }
+ .handoff-body dl {
+   margin: var(--sp-2) 0;
+ }
+ .handoff-body dl > div {
