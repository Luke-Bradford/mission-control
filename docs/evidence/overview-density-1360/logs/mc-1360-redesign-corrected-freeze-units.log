+
+ .repokanbans {
+   flex: 1;
+   min-width: 0;
+   min-height: 0;
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-3);
+   overflow: auto;
+ }
+
+ .repokanban {
+   display: flex;
+   flex-direction: column;
+   min-height: 0;
