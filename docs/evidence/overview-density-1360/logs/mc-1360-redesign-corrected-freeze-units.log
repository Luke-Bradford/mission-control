+ .ch-full-text:focus-visible {
+   outline: 2px solid var(--accent);
+   outline-offset: 2px;
+ }
+
+ .ch-risk {
+   display: grid;
+   gap: var(--sp-4);
+   min-width: 0;
+ }
+ .ch-risk-toolbar {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-3);
+   padding: var(--sp-2) var(--sp-4);
+ }
+ .ch-risk-toolbar label {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-2);
+ }
+ .ch-risk-toolbar input {
+   width: 24px;
+   height: 24px;
+   margin: 0;
+ }
+ .ch-risk-table,
+ .ch-risk-coupling {
+   overflow: auto;
+   scrollbar-gutter: stable;
+   max-height: 224px;
+ }
+ .ch-risk table {
+   width: 100%;
+   table-layout: fixed;
+   font: var(--fs) / var(--lh) var(--sans);
+ }
+ .ch-risk caption {
+   caption-side: bottom;
+   text-align: left;
+   font: var(--fs-s) / var(--lh-s) var(--sans);
+   padding: var(--sp-2) var(--sp-4);
+   color: var(--fg-2);
+ }
+ .ch-risk th,
+ .ch-risk td {
+   padding: var(--sp-1) var(--sp-2);
+   height: 40px;
+   vertical-align: middle;
+   overflow-wrap: anywhere;
+ }
+ .ch-risk th {
+   text-align: left;
+   font-weight: 400;
+ }
+ .ch-risk thead {
+   position: sticky;
+   top: 0;
+   background: var(--surface);
+   z-index: 1;
+ }
+ .ch-risk th.ch-number {
+   text-align: right;
+ }
+ .ch-risk-table th:first-child {
+   width: 38%;
+ }
+ .ch-risk-table th:last-child {
+   width: 18%;
+ }
+ .ch-risk thead button {
+   padding: var(--sp-1);
+   font: var(--fs-s) / var(--lh-s) var(--sans);
+ }
+ .ch-risk .ch-risk-path {
+   display: -webkit-box;
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 2;
+   overflow: hidden;
+   white-space: normal;
+   text-align: left;
+   width: 100%;
+   background: transparent;
+   color: var(--accent);
+   border: 0;
+   padding: var(--sp-1);
+   overflow-wrap: anywhere;
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+ }
+ .ch-risk-bar {
+   display: block;
+   height: 4px;
+   background: var(--surface-2);
+   margin-top: var(--sp-1);
+ }
+ .ch-risk-bar > span {
+   display: block;
+   height: 100%;
+   background: var(--accent);
+ }
+ .ch-risk-lower {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+   gap: var(--sp-4);
+   align-items: start;
+ }
+ .ch-risk-histories {
+   max-height: 192px;
+   overflow: auto;
+   scrollbar-gutter: stable;
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+   gap: var(--sp-3);
+   padding: var(--sp-4);
+ }
+ .ch-risk-histories section {
+   min-width: 0;
+ }
+ .ch-risk-histories svg {
+   display: block;
+   width: 100%;
+   height: 64px;
+   fill: var(--accent);
+ }
+ .ch-risk-axis {
+   fill: none;
+   stroke: var(--line-2);
+ }
+ .ch-risk-line {
+   fill: none;
+   stroke: var(--accent);
+   stroke-width: 2;
+ }
+ .ch-risk-point-labels {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1);
+ }
+ .ch-risk .ch-risk-point-labels button {
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   padding: var(--sp-1);
+ }
+ .ch-risk-coupling th:first-child {
+   width: 60%;
+ }
+ .ch-risk :focus-visible {
+   outline: 2px solid var(--accent);
+   outline-offset: -2px;
+ }
+ @container (max-width: 860px) {
+   .ch-risk-lower {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
+ @container (max-width: 500px) {
+   .ch-risk-histories {
+     grid-template-columns: minmax(0, 1fr);
+   }
+   .ch-risk table {
+     min-width: 480px;
+   }
+ }
+
+ .comms-right {
+   display: flex;
+   flex-direction: column;
+   min-width: 0;
+   min-height: 0;
+   gap: var(--sp-3);
+ }
+ .comms-graph-panel {
+   display: flex;
+   flex: 1 0 auto;
+   flex-direction: column;
+   min-height: 390px;
+ }
+ .comms-graph-panel > .ph,
+ .comms-traffic-panel > .ph {
+   flex: 0 0 auto;
+ }
+
+ /* Msgs / Tokens: a segmented switch; the live segment is tinted, never outlined. */
+ .comms-metric {
+   display: inline-flex;
+   min-width: 0;
+   margin: 0;
+   padding: var(--sp-1);
+   background: var(--bg);
+   border: 1px solid var(--line);
+   border-radius: 3px;
+ }
+ .comms-metric button {
+   min-height: 24px;
+   padding: var(--sp-1) var(--sp-2);
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   background: transparent;
+   border: 0;
+   border-radius: 2px;
+   transition:
+     color 150ms ease,
+     background-color 150ms ease;
+ }
+ .comms-metric button:hover {
+   color: var(--fg-2);
+ }
+ .comms-metric button.on {
+   color: var(--accent);
+   background: var(--accent-soft);
+ }
+
+ /* Readout: the network's totals in one mono line above the graph. */
+ .comms-graph-readout {
+   display: flex;
+   flex: 0 0 auto;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-3);
+   padding: var(--sp-2) var(--sp-3) 0;
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+ }
+ .comms-graph-readout b {
+   color: var(--fg-2);
+   font-weight: 500;
+   font-variant-numeric: tabular-nums;
+ }
+ .comms-graph-readout .live {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   color: var(--accent);
+ }
+ .comms-live-dot {
+   width: 6px;
+   height: 6px;
+   background: var(--accent);
+   border-radius: 50%;
+ }
+
+ /* The stage takes the panel's spare height; the spider lays itself out in the measured box. */
+ .comms-graph-stage {
+   position: relative;
+   flex: 1 1 auto;
+   min-height: 340px;
+   margin: var(--sp-1) var(--sp-3) 0;
+ }
+ .comms-spider {
+   position: absolute;
+   inset: 0;
+   margin: 0;
+ }
+ .comms-spider-svg {
+   position: absolute;
+   inset: 0;
+   width: 100%;
+   height: 100%;
+   overflow: visible;
+ }
+
+ /* The scale: two range rings, the CAPCOM–#crew axis and one leg per role, all hairlines. */
+ .comms-spider-scale ellipse,
+ .comms-spider-scale .axis {
+   fill: none;
+   stroke: var(--line);
+   stroke-dasharray: 2 4;
+   stroke-width: 1;
+ }
+ .comms-spider-scale ellipse.inner {
+   stroke-dasharray: 1 5;
+ }
+ .comms-spoke-line {
+   stroke: var(--line-2);
+   stroke-width: 1;
+ }
+ .comms-spoke-name {
+   fill: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.14em;
+   opacity: 0.8;
+ }
+ .comms-spoke.away .comms-spoke-line {
+   opacity: 0.4;
+ }
+ .comms-spoke.away .comms-spoke-name {
+   opacity: 0.55;
+ }
+ .away-mark {
+   font-size: var(--fs-s);
+   letter-spacing: 0.08em;
+   text-transform: lowercase;
+ }
+
+ /* Links: weight and brightness both follow the message count (--w, 0..1). */
+ .comms-edge {
+   cursor: pointer;
+ }
+ .comms-edge-hit {
+   fill: none;
+   stroke: transparent;
+   stroke-width: 12;
+   pointer-events: stroke;
+ }
+ .comms-edge-line {
+   fill: none;
+   stroke: var(--fg-2);
+   stroke-linecap: round;
+   opacity: calc(0.24 + var(--w, 0) * 0.5);
+   pointer-events: none;
+   transition:
+     opacity 150ms ease,
+     stroke 400ms ease;
+ }
+ .comms-edge:hover .comms-edge-line {
+   stroke: var(--fg);
+   opacity: 0.9;
+ }
+ .comms-edge.focus .comms-edge-line {
+   stroke: var(--accent);
+   opacity: calc(0.55 + var(--w, 0) * 0.45);
+ }
+ .comms-edge.watching .comms-edge-line {
+   stroke: var(--warn);
+   opacity: 0.9;
+ }
+ .comms-edge.live .comms-edge-line {
+   stroke: var(--accent);
+   opacity: 0.95;
+ }
+ .comms-edge.dim .comms-edge-line {
+   opacity: 0.1;
+ }
+ /*
+  * A link's count is a chip, shown only while the link or one of its ends is hovered or focused, or
+  * the page is about it: at rest the web is nodes, lines and names.
+  */
+ .comms-edge-count {
+   opacity: 0;
+   pointer-events: none;
+   transition: opacity 150ms ease;
+ }
+ .comms-edge:hover .comms-edge-count,
+ .comms-edge:focus-visible .comms-edge-count,
+ .comms-edge.near .comms-edge-count,
+ .comms-edge.focus .comms-edge-count {
+   opacity: 1;
+ }
+ .comms-edge:focus-visible {
+   outline: none;
+ }
+ .comms-edge:focus-visible .comms-edge-line,
+ .comms-edge.near .comms-edge-line {
+   stroke: var(--fg);
+   opacity: 0.9;
+ }
+ .comms-edge-chip {
+   fill: var(--surface);
+   stroke: var(--line-2);
+   stroke-width: 1;
+ }
+ .comms-edge-num {
+   fill: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-variant-numeric: tabular-nums;
+ }
+ .comms-edge.focus .comms-edge-num,
+ .comms-edge:hover .comms-edge-num {
+   fill: var(--fg);
+ }
+ .comms-edge.focus .comms-edge-chip,
+ .comms-edge.live .comms-edge-chip {
+   stroke: var(--accent);
+ }
+ .comms-edge.dim .comms-edge-num {
+   opacity: 0.4;
+ }
+
+ /* A message in flight: a bright head with a short fading tail, riding its link. */
+ .comms-particle > circle {
+   fill: var(--accent);
+   pointer-events: none;
+ }
+ .comms-particle .trail {
+   opacity: 0.3;
+ }
+ .comms-particle .trail + .trail {
+   opacity: 0.55;
+ }
+ .comms-particle .head {
+   filter: drop-shadow(0 0 3px var(--accent));
+ }
+
+ /*
+  * Nodes. Colour is the seat's identity (--node-color); presence sets fill, size, glow and opacity:
+  * running is solid and breathes, idle is a tinted ring, stopped is a dashed outline set back.
+  */
+ .comms-node {
+   cursor: pointer;
+   outline: none;
+   transition: opacity 400ms ease;
+ }
+ .comms-node-hit {
+   fill: transparent;
+ }
+ .comms-node-core {
+   fill: color-mix(in srgb, var(--node-color) 30%, var(--surface));
+   stroke: color-mix(in srgb, var(--node-color) 80%, var(--surface));
+   stroke-width: 1.25;
+   transition:
+     r 500ms ease,
+     fill 400ms ease,
+     stroke 400ms ease;
+ }
+ /* The glow is two soft rings, not a blur, so breathing it only changes opacity. */
+ .comms-node-halo {
+   fill: var(--node-color);
+   opacity: 0;
+   pointer-events: none;
+   transition: opacity 400ms ease;
+ }
+ .comms-node-halo circle {
+   fill-opacity: 0.16;
+ }
+ .comms-node-halo circle + circle {
+   fill-opacity: 0.3;
+ }
+ .comms-node-ring {
+   fill: none;
+   stroke: var(--accent);
+   stroke-width: 1;
+   opacity: 0;
+   transition: opacity 150ms ease;
+ }
+ .comms-node-name {
+   fill: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-weight: 500;
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   paint-order: stroke;
+   stroke: var(--surface);
+   stroke-width: 3px;
+   stroke-linejoin: round;
+   pointer-events: none;
+   transition: fill 150ms ease;
+ }
+ .comms-node.presence-running .comms-node-core {
+   fill: var(--node-color);
+   stroke: color-mix(in srgb, var(--node-color) 60%, var(--fg));
+ }
+ .comms-node.presence-running .comms-node-halo {
+   opacity: 0.8;
+ }
+ .comms-node.presence-running .comms-node-name {
+   fill: var(--fg);
+ }
+ .comms-node.presence-idle {
+   opacity: 0.82;
+ }
+ .comms-node.presence-stopped {
+   opacity: 0.62;
+ }
+ .comms-node.presence-stopped .comms-node-core {
+   fill: var(--surface);
+   stroke: color-mix(in srgb, var(--node-color) 50%, var(--muted));
+ }
+ .comms-node.presence-stopped .comms-node-name {
+   fill: var(--muted);
+ }
+ .comms-node.alert .comms-node-core {
+   stroke: var(--crit);
+   stroke-width: 1.5;
+   stroke-dasharray: none;
+ }
+ /* Hubs are rings with a core: FLIGHT (accent), CAPCOM (ink) and the #crew channel. */
+ .comms-node.hub .comms-node-core {
+   fill: var(--surface);
+   stroke: var(--node-color);
+   stroke-width: 1.5;
+ }
+ .comms-node.hub .comms-node-inner {
+   fill: color-mix(in srgb, var(--node-color) 55%, var(--surface));
+   pointer-events: none;
+ }
+ .comms-node.hub.presence-running .comms-node-inner {
+   fill: var(--node-color);
+ }
+ .comms-node.hub .comms-node-name {
+   fill: var(--fg);
+   font-weight: 600;
+ }
+ .comms-node.hub.presence-idle,
+ .comms-node.hub.presence-stopped {
+   opacity: 1;
+ }
+ .comms-node.hub.presence-stopped .comms-node-core {
+   stroke: var(--muted);
+ }
+ .comms-node:hover .comms-node-ring {
+   stroke: var(--fg-2);
+   opacity: 0.6;
+ }
+ .comms-node:hover,
+ .comms-node:focus-visible {
+   opacity: 1;
+ }
+ .comms-node:focus-visible .comms-node-ring {
+   stroke: var(--accent);
+   stroke-dasharray: 2 2;
+   opacity: 1;
+ }
+ .comms-node.selected .comms-node-ring {
+   stroke: var(--accent);
+   stroke-dasharray: none;
+   opacity: 1;
+ }
+ .comms-node.selected .comms-node-name {
+   fill: var(--accent);
+ }
+ .comms-node.live > .comms-node-body > .comms-node-core {
+   stroke: var(--accent);
+ }
+ .comms-node.dim {
+   opacity: 0.28;
+ }
+ .comms-node.leaving {
+   pointer-events: none;
+ }
+ .comms-node-ping {
+   fill: none;
+   stroke: var(--accent);
+   stroke-width: 1;
+   pointer-events: none;
+   opacity: 0;
+ }
+ @media (prefers-reduced-motion: no-preference) {
+   .comms-node-body {
+     animation: comms-spider-enter 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
+   }
+   .comms-node.leaving .comms-node-body {
+     animation: comms-spider-leave 650ms ease-in both;
+   }
+   .comms-node.presence-running .comms-node-halo {
+     animation: comms-spider-breathe 2.8s ease-in-out infinite;
+   }
+   /* The resting drift: a slow lap of a few pixels per node, on the compositor, no frames. */
+   .comms-node-drift {
+     animation: comms-node-drift var(--drift-s, 12s) ease-in-out var(--drift-at, 0s) infinite;
+   }
+   .comms-spider.offscreen .comms-node .comms-node-drift,
+   .comms-spider.offscreen .comms-node .comms-node-halo {
+     animation-play-state: paused;
+   }
+   .comms-node-ping {
+     animation: comms-spider-ping 900ms ease-out 1 forwards;
+   }
+   .comms-live-dot {
+     animation: comms-live 2.4s ease-in-out infinite;
+   }
+ }
+ @media (prefers-reduced-motion: reduce) {
+   .comms-node,
+   .comms-node-core,
+   .comms-node-halo,
+   .comms-edge-line {
+     transition: none;
+   }
+ }
+ @keyframes comms-spider-enter {
+   from {
+     opacity: 0;
+     transform: scale(0.2);
+   }
+   to {
+     opacity: 1;
+     transform: scale(1);
+   }
+ }
+ @keyframes comms-spider-leave {
+   to {
+     opacity: 0;
+     transform: scale(0.3);
+   }
+ }
+ @keyframes comms-spider-breathe {
+   0%,
+   100% {
+     opacity: 0.45;
+   }
+   50% {
+     opacity: 1;
+   }
+ }
+ @keyframes comms-node-drift {
+   0%,
+   100% {
+     transform: translate(0, 0);
+   }
+   25% {
+     transform: translate(2.5px, -1.5px);
+   }
+   50% {
+     transform: translate(0.5px, 2.5px);
+   }
+   75% {
+     transform: translate(-2.5px, 0.5px);
+   }
+ }
+ @keyframes comms-spider-ping {
+   from {
+     opacity: 0.9;
+     transform: scale(1);
+   }
+   to {
+     opacity: 0;
+     transform: scale(2.6);
+   }
+ }
+ @keyframes comms-live {
+   0%,
+   100% {
+     opacity: 1;
+   }
+   50% {
+     opacity: 0.3;
+   }
+ }
+
+ /* The hover card: who, state, both directions' counts, the newest message. */
+ .comms-spider-tip {
+   position: absolute;
+   z-index: 5;
+   width: 228px;
+   padding: var(--sp-2) var(--sp-2) var(--sp-2);
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+   background: var(--surface-2);
+   border: 1px solid var(--line-2);
+   border-radius: var(--r-s);
+   pointer-events: none;
+ }
+ .tip-head,
+ .tip-state,
+ .tip-last {
+   margin: 0;
+ }
+ .tip-head {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-1);
+   min-width: 0;
+ }
+ .tip-dot {
+   flex: 0 0 auto;
+   width: 7px;
+   height: 7px;
+   border-radius: 50%;
+ }
+ .tip-name {
+   overflow: hidden;
+   color: var(--fg);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-weight: 600;
+   letter-spacing: 0.04em;
+   text-overflow: ellipsis;
+   text-transform: uppercase;
+   white-space: nowrap;
+ }
+ .tip-role {
+   overflow: hidden;
+   color: var(--muted);
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+ .tip-state {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-1);
+   margin-top: var(--sp-1);
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+ }
+ .tip-state-dot {
+   width: 6px;
+   height: 6px;
+   border: 1px solid var(--fg-2);
+   border-radius: 50%;
+ }
+ .presence-running > .tip-state-dot {
+   background: var(--ok);
+   border-color: var(--ok);
+ }
+ .presence-stopped > .tip-state-dot {
+   border-style: dashed;
+   border-color: var(--muted);
+ }
+ .alert > .tip-state-dot {
+   background: var(--crit);
+   border-color: var(--crit);
+ }
+ .tip-stats {
+   display: flex;
+   gap: var(--sp-3);
+   margin: var(--sp-2) 0 0;
+   padding: var(--sp-1) 0 0;
+   border-top: 1px solid var(--line);
+ }
+ .tip-stat {
+   min-width: 0;
+ }
+ .tip-stat dt {
+   overflow: hidden;
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.08em;
+   text-overflow: ellipsis;
+   text-transform: uppercase;
+   white-space: nowrap;
+ }
+ .tip-stat dd {
+   margin: 0 0 0;
+   color: var(--fg);
+   font-family: var(--display);
+   font-size: var(--fs-panel);
+   font-variant-numeric: tabular-nums;
+   line-height: var(--lh-panel);
+ }
+ .tip-last {
+   margin-top: var(--sp-2);
+   padding-top: var(--sp-1);
+   border-top: 1px solid var(--line);
+ }
+ .tip-meta {
+   display: block;
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.04em;
+ }
+ .tip-last q {
+   display: -webkit-box;
+   margin-top: var(--sp-1);
+   overflow: hidden;
+   color: var(--fg-2);
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 3;
+   quotes: none;
+ }
+ .tip-last.none {
+   color: var(--muted);
+ }
+
+ /* Legend: presence, link weight and the message particle, in one mono row under the plot. */
+ .comms-spider-legend {
+   position: absolute;
+   right: 0;
+   bottom: 2px;
+   left: 0;
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-2);
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   pointer-events: none;
+ }
+ .comms-spider-legend > span {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+ }
+ .comms-spider-legend > span > b {
+   color: var(--fg-2);
+   font-weight: 500;
+   font-variant-numeric: tabular-nums;
+ }
+ .comms-spider-legend .key {
+   display: block;
+   width: 8px;
+   height: 8px;
+   border-radius: 50%;
+ }
+ .comms-spider-legend .running .key {
+   background: var(--fg-2);
+   box-shadow: 0 0 0 2px color-mix(in srgb, var(--fg-2) 25%, transparent);
+ }
+ .comms-spider-legend .idle .key {
+   background: color-mix(in srgb, var(--fg-2) 30%, var(--surface));
+   border: 1px solid var(--fg-2);
+ }
+ .comms-spider-legend .stopped .key {
+   border: 1px solid var(--muted);
+ }
+ .comms-spider-legend .link .key {
+   width: 14px;
+   height: 0;
+   border-top: 2px solid var(--fg-2);
+   border-radius: 0;
+   opacity: 0.6;
+ }
+ .comms-spider-legend .particle .key {
+   width: 5px;
+   height: 5px;
+   background: var(--accent);
+ }
+ .comms-spider-legend .particle {
+   margin-left: auto;
+ }
+ /* Away: seats stopped and quiet, off the web; a disclosure lists them (hover or click). */
+ .comms-spider-legend > .away-wrap {
+   position: relative;
+   pointer-events: auto;
+ }
+ .comms-spider-legend .away {
+   display: inline-flex;
+   align-items: center;
+   min-width: 24px;
+   min-height: 24px;
+   padding: 0 var(--sp-1);
+   color: var(--muted);
+   font: inherit;
+   font-size: var(--fs-s);
+   letter-spacing: inherit;
+   text-transform: inherit;
+   background: transparent;
+   border: 0;
+   border-bottom: 1px dotted var(--muted);
+   border-radius: 0;
+   cursor: default;
+   pointer-events: auto;
+ }
+ .comms-spider-legend .away:hover,
+ .comms-spider-legend .away:focus-visible,
+ .comms-spider-legend .away[aria-expanded="true"] {
+   color: var(--fg-2);
+   outline: none;
+ }
+ .comms-spider-away {
+   position: absolute;
+   margin: 0;
+   list-style: none;
+   bottom: calc(100% + 6px);
+   left: 0;
+   z-index: 5;
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 190px;
+   padding: var(--sp-2) var(--sp-2);
+   color: var(--muted);
+   text-align: left;
+   text-transform: none;
+   letter-spacing: 0.02em;
+   white-space: nowrap;
+   background: var(--surface-2);
+   border: 1px solid var(--line-2);
+   border-radius: var(--r-s);
+ }
+ .away-name {
+   margin-right: var(--sp-1);
+   color: var(--fg-2);
+   font-weight: 500;
+   text-transform: uppercase;
+ }
+
+ .comms-empty,
+ .comms-token-empty {
+   position: absolute;
+   right: 12px;
+   bottom: 28px;
+   left: 12px;
+   margin: 0;
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   letter-spacing: 0.04em;
+   text-align: center;
+   pointer-events: none;
+ }
+ .comms-token-empty {
+   bottom: auto;
+   top: 6px;
+ }
+
+ /* Chatter watch: a status line, amber only when a pair is going round in circles. */
+ .comms-watch {
+   flex: 0 0 auto;
+   padding: var(--sp-2) var(--sp-3) var(--sp-2);
+   border-top: 1px solid var(--line);
+ }
+ .comms-watch-head {
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-weight: 600;
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+ }
+ .comms-watch-head span {
+   color: var(--muted);
+   font-weight: 400;
+   letter-spacing: 0.04em;
+   text-transform: none;
+ }
+ .comms-watch p {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr);
+   gap: var(--sp-1);
+   margin: var(--sp-2) 0 0;
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+ .comms-watch p b {
+   color: var(--warn);
+   font-family: var(--mono);
+   font-weight: 500;
+ }
+ .comms-watch p.clear {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   color: var(--muted);
+ }
+ .comms-watch p.clear::before {
+   width: 6px;
+   height: 6px;
+   background: var(--ok);
+   border-radius: 50%;
+   content: "";
+ }
+ .comms-watch-bar {
+   display: block;
+   height: 3px;
+   background: var(--line);
+ }
+ .comms-watch-bar i {
+   display: block;
+   height: 100%;
+   background: var(--warn);
+ }
+
+ /* Traffic: four readings with units, then the hourly instrument. */
+ .comms-traffic-panel {
+   flex: 0 0 auto;
+ }
+ .comms-traffic-stats {
+   display: grid;
+   grid-template-columns: repeat(4, minmax(0, 1fr));
+   border-bottom: 1px solid var(--line);
+ }
+ .comms-traffic-stats > div {
+   min-width: 0;
+   padding: var(--sp-2) var(--sp-2) var(--sp-2);
+ }
+ .comms-traffic-stats > div + div {
+   border-left: 1px solid var(--line);
+ }
+ .comms-stat-figure {
+   display: flex;
+   align-items: baseline;
+   gap: var(--sp-1);
+ }
+ .comms-traffic-stats strong {
+   color: var(--fg);
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 500;
+   font-variant-numeric: tabular-nums;
+   line-height: var(--lh-title);
+ }
+ .comms-traffic-stats em {
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-style: normal;
+ }
+ .comms-traffic-stats strong.think {
+   color: var(--think);
+ }
+ .comms-traffic-stats strong.accent {
+   color: var(--accent);
+ }
+ .comms-traffic-stats strong.agent {
+   color: var(--ok);
+ }
+ .comms-traffic-stats .nil strong {
+   color: var(--muted);
+ }
+ .comms-traffic-stats > div > span:last-child {
+   display: block;
+   margin-top: var(--sp-1);
+   overflow: hidden;
+   color: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.04em;
+   line-height: var(--lh-micro);
+   text-overflow: ellipsis;
+   text-transform: uppercase;
+   white-space: nowrap;
+ }
+
+ .comms-chart {
+   position: relative;
+   margin: 0;
+   padding: var(--sp-2) var(--sp-3) var(--sp-2) var(--sp-1);
+ }
+ .comms-chart svg {
+   display: block;
+   width: 100%;
+   height: auto;
+   overflow: visible;
+ }
+ .comms-chart-grid line {
+   stroke: var(--line);
+   stroke-dasharray: 2 3;
+   stroke-width: 1;
+ }
+ .comms-chart-grid.base line {
+   stroke: var(--line-2);
+   stroke-dasharray: none;
+ }
+ .comms-chart-grid text,
+ .comms-chart-tick {
+   fill: var(--muted);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-variant-numeric: tabular-nums;
+ }
+ .comms-chart-trace {
+   fill: none;
+   stroke: var(--accent);
+   stroke-width: 1.5;
+   stroke-linejoin: round;
+   stroke-linecap: round;
+ }
+ .comms-chart-part {
+   fill: none;
+   stroke: var(--fg-2);
+   stroke-dasharray: 3 2;
+   stroke-width: 1;
+   stroke-linejoin: round;
+ }
+ .comms-chart-now {
+   stroke: var(--accent);
+   stroke-width: 1;
+   opacity: 0.7;
+ }
+ @media (prefers-reduced-motion: no-preference) {
+   .comms-chart-now.live {
+     animation: comms-live 2.4s ease-in-out infinite;
+   }
+ }
+ .comms-hour {
+   fill: transparent;
+ }
+ .comms-hour:hover {
+   fill: var(--accent-soft);
+ }
+ .comms-chart-legend,
+ .comms-chart-empty {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-3);
+   align-items: center;
+   margin: var(--sp-1) 0 0 var(--sp-1);
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.04em;
+ }
+ .comms-chart-legend span {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+ }
+ .comms-chart-legend i {
+   width: 12px;
+   height: 0;
+   border-top: 1.5px solid var(--accent);
+ }
+ .comms-chart-legend .part i {
+   border-top: 1px dashed var(--fg-2);
+ }
+ .comms-chart-legend .unit {
+   margin-left: auto;
+   color: var(--muted);
+ }
+ .comms-chart-empty {
+   position: absolute;
+   top: 38%;
+   right: 12px;
+   left: 30px;
+   justify-content: center;
+   margin: 0;
+   padding: var(--sp-1) var(--sp-2);
+   color: var(--muted);
+   text-align: center;
+   background: color-mix(in srgb, var(--surface) 88%, transparent);
+ }
+ .comms-traffic-empty {
+   margin: 0;
+   padding: var(--sp-4) var(--sp-3);
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ /* Message length p95: one row per sender, a bar against the limit; near and over are marked. */
+ .comms-length-panel {
+   display: flex;
+   flex: 0 0 auto;
+   flex-direction: column;
+   min-height: 0;
+ }
+ .comms-length-list {
+   max-height: calc(6 * 35px);
+   overflow-y: auto;
+   display: grid;
+   gap: var(--sp-2);
+   margin: 0;
+   padding: var(--sp-2) var(--sp-3);
+   list-style: none;
+ }
+ .comms-length-list li {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto auto;
+   align-items: baseline;
+   gap: var(--sp-1) var(--sp-2);
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+ .comms-length-list b {
+   overflow: hidden;
+   font-family: var(--mono);
+   font-weight: 500;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+ .comms-length-value {
+   font-family: var(--mono);
+   font-variant-numeric: tabular-nums;
+ }
+ .comms-length-value em {
+   font-style: normal;
+ }
+ .comms-length-n {
+   min-width: 6ch;
+   color: var(--muted);
+   font-family: var(--mono);
+   text-align: right;
+ }
+ .comms-length-list .comms-watch-bar {
+   grid-column: 1 / -1;
+ }
+ .comms-length-list .comms-watch-bar i {
+   background: var(--muted);
+ }
+ .comms-length-list li.near .comms-length-value {
+   color: var(--warn);
+ }
+ .comms-length-list li.near .comms-watch-bar i {
+   background: var(--warn);
+ }
+ .comms-length-list li.over .comms-length-value {
+   color: var(--crit);
+ }
+ .comms-length-list li.over .comms-watch-bar i {
+   background: var(--crit);
+ }
+ .comms-length-stale {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   margin: 0;
+   padding: var(--sp-2) var(--sp-3) 0;
+   color: var(--warn);
+   font-size: var(--fs-s);
+ }
+ .comms-length-stale i {
+   width: 6px;
+   height: 6px;
+   background: var(--warn);
+   transform: rotate(45deg);
+ }
+
+ .optlist {
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .nopts {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1);
+   margin-top: var(--sp-1);
+ }
+
+ .opt {
+   position: relative;
+   display: grid;
+   gap: var(--sp-1);
+   text-align: left;
+   white-space: normal;
+   padding: var(--sp-2) var(--sp-2);
+   background: var(--surface);
+ }
+
+ .opt.rec {
+   border-color: var(--ok);
+ }
+
+ div.opt {
+   border: 1px solid var(--line-2);
+   border-radius: var(--r-s);
+ }
+
+ #dsOpts .nopts {
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ #dsOpts .nopts button {
+   max-width: 100%;
+   white-space: normal;
+   overflow-wrap: anywhere;
+ }
+
+ #dsOpts .optlist {
+   width: 100%;
+   min-width: 0;
+ }
+
+ /* biome-ignore-all lint/style/noDescendingSpecificity: later rules override earlier ones by order here, as in hud.css */
+ @import "./CommsGraph.css";
+
+ .msg.peer {
+   padding-left: var(--sp-6);
+ }
+
+ .msg.peer .body {
+   color: var(--fg-2);
+ }
+
+ .comms-page,
+ .comms-grid,
+ .comms-left,
+ .comms-agent,
+ .comms-agent #chatP {
+   min-height: 0;
+ }
+
+ .comms-page {
+   height: 100%;
+   overflow: hidden;
+ }
+
+ .comms-grid {
+   display: grid;
+   grid-template-columns: 280px minmax(0, 1fr) minmax(300px, 380px);
+   gap: var(--sp-3);
+   height: 100%;
+   overflow: hidden;
+ }
+
+ .comms-left,
+ .comms-nav,
+ .comms-contacts {
+   display: flex;
+   flex-direction: column;
+   min-height: 0;
+ }
+
+ .comms-left,
+ .comms-right {
+   overflow-y: auto;
+ }
+
+ .comms-decisions {
+   display: flex;
+   flex: 0 0 auto;
+   flex-direction: column;
+   max-height: 46%;
+   min-height: 0;
+   overflow: hidden;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+ }
+
+ .comms-section-head {
+   display: flex;
+   align-items: baseline;
+   gap: var(--sp-2);
+   padding: var(--sp-2) var(--sp-3);
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   font-weight: 600;
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+ }
+
+ .comms-section-head h2 {
+   font: inherit;
+ }
+
+ .comms-section-head span {
+   color: var(--muted);
+   font-size: var(--fs-s);
+   font-weight: 400;
+   letter-spacing: 0;
+   text-transform: none;
+ }
+
+ /* The Needs-you count beside Decisions: the whole inbox, linked to its home on FLIGHT. */
+ .comms-section-head .comms-needs-link {
+   display: inline-flex;
+   align-items: center;
+   min-height: 24px;
+   color: var(--accent);
+   font-size: var(--fs-s);
+   font-weight: 400;
+   letter-spacing: 0;
+   text-transform: none;
+   text-decoration: none;
+ }
+
+ .comms-section-head .comms-needs-link:hover {
+   text-decoration: underline;
+ }
+
+ .comms-decision-list {
+   min-height: 0;
+   overflow: auto;
+ }
+
+ .comms-nav,
+ .comms-contacts {
+   flex: 1 1 auto;
+   overflow: auto;
+   border: 1px solid var(--line);
+   background: var(--surface);
+ }
+
+ .comms-nav button,
+ .comms-contacts button {
+   padding: var(--sp-2) var(--sp-3) var(--sp-2) var(--sp-3);
+   color: var(--fg);
+   text-align: left;
+   background: transparent;
+   border: 0;
+   border-bottom: 1px solid var(--line);
+   border-radius: 0;
+   transition:
+     background-color 150ms ease,
+     box-shadow 150ms ease;
+ }
+
+ /* The lists are flex columns that scroll: a row keeps its own height rather than squeezing into
+    the one below when there are more rows than room. */
+ .comms-nav button,
+ .comms-contacts button {
+   flex: none;
+ }
+
+ .comms-nav button:hover,
+ .comms-contacts button:hover {
+   background: color-mix(in srgb, var(--fg) 4%, transparent);
+ }
+
+ .comms-nav button:focus-visible,
+ .comms-contacts button:focus-visible {
+   outline-offset: -2px;
+ }
+
+ .comms-nav > .comms-section-head {
+   border-bottom: 1px solid var(--line);
+ }
+
+ .comms-nav-top,
+ .comms-nav-row {
+   display: grid;
+   grid-template-columns: 10px minmax(0, 1fr) auto;
+   gap: var(--sp-2);
+   align-items: center;
+ }
+
+ .comms-nav-top > i,
+ .comms-nav-row > i {
+   width: 7px;
+   height: 7px;
+   border-radius: 50%;
+   background: var(--accent);
+ }
+
+ .comms-nav-top > i {
+   border-radius: 1px;
+ }
+
+ .comms-nav-top > i.crew {
+   background: var(--fg-2);
+ }
+
+ .comms-nav-agent b {
+   font-weight: 500;
+   letter-spacing: 0.01em;
+ }
+
+ .comms-nav-row .comms-nav-agent b {
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   letter-spacing: 0.04em;
+ }
+
+ .comms-nav-agent {
+   min-width: 0;
+ }
+
+ .comms-nav-agent b,
+ .comms-nav-agent small {
+   display: block;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .comms-nav-counts {
+   display: inline-flex;
+   gap: var(--sp-1);
+   align-items: center;
+ }
+
+ .comms-nav-counts > small {
+   min-width: 2ch;
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-variant-numeric: tabular-nums;
+   text-align: right;
+ }
+
+ /* Full-opacity --muted clears 4.5:1 on --surface in both themes (5.4 dark, 5.1 light); on a
+    selected row's accent tint it would not (4.1 / 4.4), so a zero there reads in --fg-2. */
+ .comms-nav-counts > small.zero {
+   color: var(--muted);
+ }
+
+ .comms-nav button.on .comms-nav-counts > small.zero {
+   color: var(--fg-2);
+ }
+
+ /* Unread and mention counts: compact filled chips, mono numerals. */
+ .comms-nav .comms-unread-count,
+ .comms-nav .comms-mention-count {
+   min-width: 18px;
+   height: 16px;
+   padding: 0 var(--sp-1);
+   color: var(--accent);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   font-variant-numeric: tabular-nums;
+   text-align: center;
+   background: color-mix(in srgb, var(--accent) 18%, transparent);
+   border-radius: 2px;
+ }
+
+ .comms-nav .comms-mention-count {
+   color: var(--warn);
+   background: var(--warn-soft);
+ }
+
+ /* Selection is an edge, not a box: a 2px accent bar on the left over a soft tint. */
+ .comms-nav button.on,
+ .comms-contacts button.on {
+   background: var(--accent-soft);
+   box-shadow: inset 2px 0 0 var(--accent);
+ }
+
+ .comms-nav button.on .comms-nav-agent b,
+ .comms-contacts button.on {
+   color: var(--fg);
+ }
+
+ .comms-nav-row small,
+ .comms-contacts small {
+   display: block;
+   overflow: hidden;
+   color: var(--muted);
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .comms-agent {
+   display: grid;
+   grid-template-columns: 220px minmax(0, 1fr);
+   grid-template-rows: minmax(0, 1fr);
+   gap: var(--sp-3);
+   height: 100%;
+   overflow: hidden;
+ }
+
+ #page-comms #chatP {
+   display: flex;
+   flex-direction: column;
+   min-height: 0;
+   overflow: hidden;
+ }
+
+ .comms-messages {
+   display: flex;
+   flex: 1 1 auto;
+   flex-direction: column;
+   min-height: 0;
+   overflow-x: hidden;
+   overflow-y: auto;
+   overscroll-behavior: contain;
+   scrollbar-gutter: stable;
+ }
+
+ .comms-message-stack {
+   display: flex;
+   flex-direction: column;
+   min-height: 100%;
+ }
+
+ .comms-message-stack > :first-child {
+   /* Bottom-align short chats without flex-end trapping the start of long chats above the scroller. */
+   margin-top: auto;
+ }
+
+ .comms-breadcrumb {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: center;
+   min-width: 0;
+   color: var(--accent);
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 500;
+   letter-spacing: 0.02em;
+   text-transform: none;
+   white-space: nowrap;
+ }
+
+ .comms-breadcrumb > span {
+   display: inline-flex;
+   gap: var(--sp-2);
+   align-items: center;
+ }
+
+ .comms-breadcrumb > span:first-child,
+ .comms-breadcrumb i {
+   color: var(--muted);
+   font-style: normal;
+ }
+
+ .comms-breadcrumb button {
+   padding: 0;
+   color: inherit;
+   font: inherit;
+   background: none;
+   border: 0;
+ }
+
+ /* Stored Comms: conversation-first, with the composer permanently below the scrollback. */
+ #page-comms .comms-grid > #chatP,
+ #page-comms .comms-agent > #chatP {
+   height: 100%;
+ }
+
+ .comms-chat-title {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) minmax(160px, 1fr);
+   width: 100%;
+   align-items: center;
+   gap: var(--sp-3);
+ }
+
+ #page-comms #chatP > .ph {
+   flex: 0 0 auto;
+   flex-wrap: nowrap;
+ }
+
+ #page-comms #chatP > .ph > h2 {
+   flex: 1 1 auto;
+   min-width: 0;
+ }
+
+ #page-comms #chatP > .ph > .act {
+   flex: 0 0 auto;
+ }
+
+ .comms-chat-hint {
+   overflow: hidden;
+   color: var(--muted);
+   font-family: var(--sans);
+   font-size: var(--fs-s);
+   font-weight: 400;
+   letter-spacing: 0;
+   text-align: right;
+   text-overflow: ellipsis;
+   text-transform: none;
+   white-space: nowrap;
+ }
+
+ .comms-chat-title .comms-breadcrumb {
+   min-width: 0;
+ }
+
+ .comms-mentions {
+   position: relative;
+   width: 40px;
+   height: 32px;
+ }
+
+ .comms-bell {
+   position: relative;
+   display: grid;
+   width: 40px;
+   height: 32px;
+   place-items: center;
+   color: var(--fg-2);
+   background: transparent;
+   border: 1px solid var(--line);
+   border-radius: 2px;
+ }
+
+ .comms-bell:hover {
+   color: var(--fg);
+   border-color: var(--line-2);
+ }
+
+ .comms-bell:has(b) {
+   color: var(--warn);
+ }
+
+ .comms-bell svg {
+   width: 18px;
+   height: 18px;
+   stroke-width: 1.8;
+   stroke-linecap: round;
+   stroke-linejoin: round;
+ }
+
+ .comms-bell b {
+   position: absolute;
+   top: -7px;
+   right: -7px;
+   min-width: 17px;
+   padding: 0 var(--sp-1);
+   color: var(--bg);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   background: var(--warn);
+   border-radius: 999px;
+ }
+
+ .comms-mentions-panel {
+   position: absolute;
+   z-index: 20;
+   top: 40px;
+   right: 0;
+   display: flex;
+   flex-direction: column;
+   width: min(380px, calc(100vw - 34px));
+   /* --mentions-room: the room below the bell inside #chatP, measured when the list opens */
+   max-height: min(440px, var(--mentions-room, 440px));
+   overflow: auto;
+   overscroll-behavior: contain;
+   background: var(--surface);
+   border: 1px solid var(--line-2);
+   border-radius: var(--r);
+   box-shadow: var(--shadow);
+ }
+
+ .comms-mentions-panel header {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: center;
+   padding: var(--sp-2) var(--sp-2);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .comms-mentions-panel header span {
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .comms-mentions-panel header button {
+   margin-left: auto;
+   font-size: var(--fs-s);
+ }
+
+ .comms-mentions-panel > button {
+   display: grid;
+   grid-template-columns: auto 1fr;
+   gap: var(--sp-1) var(--sp-2);
+   padding: var(--sp-2) var(--sp-3);
+   text-align: left;
+   /* buttons do not wrap by default; the mention's text clamps to two lines instead */
+   white-space: normal;
+   background: transparent;
+   border: 0;
+   border-bottom: 1px solid var(--line);
+ }
+
+ .comms-mentions-panel > button.seen {
+   opacity: 0.45;
+ }
+
+ .comms-mentions-panel > button span {
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .comms-mentions-panel > button em {
+   grid-column: 1 / -1;
+   display: -webkit-box;
+   overflow: hidden;
+   font-style: normal;
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 2;
+ }
+
+ .comms-pins {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-1);
+   padding: var(--sp-2) var(--sp-3);
+   background: var(--accent-soft);
+   border-bottom: 1px solid var(--line);
+   font-size: var(--fs-s);
+ }
+
+ .comms-pins b {
+   color: var(--warn);
+   font-size: var(--fs-s);
+   text-transform: uppercase;
+ }
+
+ .comms-ticket-strip {
+   padding: var(--sp-2) var(--sp-3);
+   color: var(--fg-2);
+   background: var(--accent-soft);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .comms-bubble {
+   position: relative;
+   align-self: flex-start;
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-1);
+   width: fit-content;
+   max-width: min(68%, 760px);
+   padding: 0;
+   border: 0;
+ }
+
+ .comms-bubble.capcom {
+   align-self: flex-end;
+ }
+
+ .comms-bubble.capcom .comms-message-meta {
+   justify-content: flex-end;
+ }
+
+ .comms-bubble.highlighted .comms-bubble-body {
+   background: var(--accent-soft);
+   box-shadow: inset 2px 0 0 var(--accent);
+ }
+
+ .comms-message-stack {
+   gap: var(--sp-3);
+   padding: var(--sp-3);
+ }
+
+ .comms-message-meta {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ /* Bubbles: hairlines only. Who spoke is told by side and tint, never by a coloured outline. */
+ .comms-bubble-body {
+   padding: var(--sp-2) var(--sp-3);
+   overflow-wrap: anywhere;
+   background: var(--surface-2);
+   border: 1px solid var(--line);
+   border-radius: 2px;
+   transition:
+     background-color 150ms ease,
+     box-shadow 150ms ease;
+ }
+
+ .comms-bubble.capcom .comms-bubble-body {
+   color: var(--fg);
+   background: color-mix(in srgb, var(--accent) 7%, var(--surface));
+ }
+
+ .comms-message-meta > span:first-child {
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-variant-numeric: tabular-nums;
+   letter-spacing: 0.02em;
+ }
+
+ /* Message actions float on the bubble's bottom edge on hover or focus, so they never take a line. */
+ .comms-actions {
+   position: absolute;
+   z-index: 3;
+   bottom: -13px;
+   left: 10px;
+   display: inline-flex;
+   gap: 0;
+   padding: var(--sp-1);
+   background: var(--surface);
+   border: 1px solid var(--line-2);
+   border-radius: 3px;
+   opacity: 0;
+   pointer-events: none;
+   transition: opacity 150ms ease;
+ }
+
+ .comms-bubble.capcom .comms-actions {
+   right: 10px;
+   left: auto;
+ }
+
+ .comms-bubble:hover .comms-actions,
+ .comms-bubble:focus-within .comms-actions {
+   opacity: 1;
+   pointer-events: auto;
+ }
+
+ .comms-actions button,
+ .comms-react-set button {
+   min-width: 24px;
+   min-height: 24px;
+   padding: 0 var(--sp-1);
+   color: var(--fg-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   background: transparent;
+   border: 0;
+   border-radius: 2px;
+ }
+
+ .comms-actions button:hover,
+ .comms-react-set button:hover {
+   color: var(--fg);
+   background: var(--accent-soft);
+ }
+
+ .comms-react-set {
+   margin: 0;
+   padding: 0 0 0 var(--sp-1);
+   border: 0;
+   border-left: 1px solid var(--line);
+ }
+
+ .comms-react-set {
+   display: inline-flex;
+   gap: 0;
+ }
+
+ .comms-quote {
+   max-width: 100%;
+   padding: var(--sp-1) var(--sp-2);
+   overflow: hidden;
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+   text-align: left;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+   background: transparent;
+   border: 0;
+   border-left: 2px solid var(--line-2);
+   border-radius: 0;
+ }
+
+ .comms-quote:hover {
+   color: var(--fg);
+   border-left-color: var(--accent);
+ }
+
+ .decision-meta {
+   display: flex;
+   gap: var(--sp-1);
+   align-items: center;
+   margin-bottom: var(--sp-2);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+
+ .decision-from {
+   padding: 0 var(--sp-1);
+   color: var(--accent);
+   background: color-mix(in srgb, var(--accent) 14%, transparent);
+   border-radius: 2px;
+ }
+
+ .decision-ticket {
+   padding: 0 var(--sp-1);
+   color: var(--fg-2);
+   background: var(--surface-2);
+   border-radius: 2px;
+ }
+
+ .decision-clock {
+   margin-left: auto;
+   color: var(--warn);
+   white-space: nowrap;
+ }
+
+ .decision-recommendation {
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+
+ .decision-card .acts button.primary {
+   color: var(--bg);
+   font-weight: 600;
+   background: var(--accent);
+   border-color: var(--accent);
+ }
+
+ .comms-right-reserved {
+   display: none;
+ }
+
+ .comms-reactions {
+   display: flex;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+ }
+
+ .comms-reactions span,
+ .comms-ref {
+   padding: 0 var(--sp-1);
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+   background: color-mix(in srgb, var(--fg) 7%, transparent);
+   border: 0;
+   border-radius: 2px;
+ }
+
+ /* Ticket and PR refs: filled chips, tinted, no outline. */
+ .comms-ref {
+   margin: 0 0;
+   padding: 0 var(--sp-1);
+   color: var(--accent);
+   font-size: var(--fs-s);
+   font-family: var(--mono);
+   line-height: var(--lh-micro);
+   vertical-align: baseline;
+   background: color-mix(in srgb, var(--accent) 14%, transparent);
+   cursor: pointer;
+   transition: background-color 150ms ease;
+ }
+
+ .comms-ref:hover {
+   background: color-mix(in srgb, var(--accent) 24%, transparent);
+ }
+
+ .comms-composer {
+   flex: 0 0 auto;
+   padding: var(--sp-2) var(--sp-3) var(--sp-3);
+   background: var(--surface);
+   border-top: 1px solid var(--line);
+ }
+
+ .comms-composer > label {
+   display: block;
+   margin-bottom: var(--sp-1);
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .comms-composer > div:last-of-type {
+   display: flex;
+   gap: var(--sp-2);
+ }
+
+ .comms-composer input {
+   flex: 1;
+   min-width: 0;
+ }
+
+ .comms-composer input {
+   min-height: 40px;
+   border-color: var(--line-2);
+   border-radius: 2px;
+ }
+
+ .comms-composer input:focus {
+   border-color: var(--accent);
+   outline: none;
+   box-shadow: inset 0 -2px 0 var(--accent);
+ }
+
+ .comms-composer input + button {
+   min-height: 40px;
+   padding: 0 var(--sp-4);
+   border-radius: 2px;
+   color: var(--accent-ink);
+   font-weight: 600;
+   background: var(--accent);
+   border-color: var(--accent);
+ }
+
+ .comms-replying {
+   display: flex;
+   gap: var(--sp-1);
+   align-items: center;
+   margin-bottom: var(--sp-1);
+   padding: var(--sp-1) var(--sp-2);
+   overflow: hidden;
+   color: var(--fg-2);
+   white-space: nowrap;
+   text-overflow: ellipsis;
+   background: var(--accent-soft);
+   border: 0;
+   border-left: 2px solid var(--accent);
+   border-radius: 0;
+   font-size: var(--fs-s);
+ }
+
+ .comms-replying button {
+   margin-left: auto;
+ }
+
+ .decision-card {
+   padding: var(--sp-2) var(--sp-3);
+   border: 1px solid var(--line);
+   border-bottom: 0;
+ }
+
+ .decision-card p,
+ .decision-card h3 {
+   margin: 0 0 var(--sp-1);
+ }
+
+ @media (max-width: 1100px) {
+   .comms-grid {
+     grid-template-columns: 240px minmax(0, 1fr);
+   }
+   .comms-right {
+     grid-column: 1 / -1;
+     display: grid;
+     grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
+   }
+   .comms-graph-panel {
+     min-height: 380px;
+   }
+ }
+
+ @media (max-width: 640px) {
+   .comms-right {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
+
+ @media (max-width: 998px) {
+   .comms-right {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
+
+ @media (max-width: 998px) {
+   .comms-grid,
+   .comms-agent {
+     grid-template-columns: minmax(0, 1fr);
+   }
+   .comms-right-reserved {
+     display: none;
+   }
+   .comms-nav,
+   .comms-contacts {
+     max-height: 220px;
+   }
+ }
+
+ @media (max-width: 700px) {
+   .comms-chat-title {
+     grid-template-columns: minmax(0, 1fr);
+   }
+   .comms-chat-hint {
+     display: none;
+   }
+ }
+
+ @media (max-width: 999px), (max-height: 559px) {
+   .comms-page,
+   .comms-grid {
+     height: auto;
+     overflow: visible;
+   }
+   #page-comms .comms-agent,
+   #page-comms .comms-agent > #chatP {
+     height: auto;
+     overflow: visible;
+   }
+   .comms-right {
+     overflow: visible;
+   }
+   #convo {
+     max-height: 60vh;
+   }
+ }
+
+ /* #638: the Hold form under a Needs-you item; labels and fields in two columns */
+ .hold-form {
+   grid-column: 2;
+   display: grid;
+   grid-template-columns: max-content minmax(0, 1fr);
+   gap: var(--sp-1) var(--sp-2);
+   align-items: center;
+   margin: var(--sp-1) 0 var(--sp-1);
+ }
+
+ .hold-form label {
+   display: contents;
+ }
+
+ .hold-form input,
+ .hold-form select {
+   min-width: 0;
+ }
+
+ .hold-form .row {
+   grid-column: 1 / -1;
+   display: flex;
+   gap: var(--sp-1);
+ }
+
+ .comms-older {
+   display: flex;
+   justify-content: center;
+   align-items: center;
+   gap: var(--sp-2);
+ }
+
+ @media (min-width: 1600px) {
+   .comms-grid {
+     grid-template-columns: 280px minmax(0, 1fr) 420px;
+   }
+ }
+
+ .crew-pause {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+   position: relative;
+   max-width: 100%;
+ }
+
+ .crew-pause-form {
+   position: fixed;
+   top: 16px;
+   right: 16px;
+   z-index: 1000;
+   width: min(300px, calc(100vw - 32px));
+   max-height: calc(100dvh - 32px);
+   overflow-y: auto;
+   box-sizing: border-box;
+   padding: var(--sp-3);
+   display: grid;
+   gap: var(--sp-2);
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: 6px;
+   box-shadow: var(--shadow);
+ }
+
+ .crew-pause-form label {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-1);
+ }
+
+ .crew-pause-form input:not([type="checkbox"]) {
+   min-width: 0;
+   flex: 1;
+ }
+
+ .crew-pause-form input[type="checkbox"] {
+   width: 24px;
+   height: 24px;
+ }
+
+ .crew-pause-audit,
+ .crew-pause-audit ul,
+ .crew-pause-audit li {
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .crew-pause-audit {
+   padding-bottom: var(--sp-2);
+   border-bottom: 1px solid var(--line);
+   font-size: var(--fs-s);
+ }
+
+ .crew-pause-audit ul {
+   list-style: none;
+   margin: 0;
+   padding: 0;
+   gap: var(--sp-3);
+ }
+
+ .crew-pause-audit summary {
+   cursor: pointer;
+   min-height: 24px;
+ }
+
+ .expandable {
+   min-width: 0;
+   max-width: 100%;
+   overflow-wrap: anywhere;
+   white-space: normal;
+ }
+
+ .expandable-content {
+   line-height: var(--lh);
+   min-width: 0;
+   overflow: hidden;
+ }
+
+ .expandable-text {
+   display: -webkit-box;
+   -webkit-box-orient: vertical;
+   overflow: hidden;
+   overflow-wrap: anywhere;
+ }
+
+ .expandable.open .expandable-content {
+   max-height: min(50vh, 24rem);
+   overflow: auto;
+ }
+
+ .expandable .expandable-text {
+   white-space: pre-wrap;
+ }
+
+ .expandable .sm {
+   margin-top: var(--sp-1);
+ }
+
+ .dmsg:has(.expandable) {
+   grid-template-columns: minmax(0, 1fr);
+ }
+
+ /* Summary disclosures keep their headers whole and their details inside the row. */
+ .disclosure > summary {
+   min-height: 24px;
+   cursor: pointer;
+   overflow-wrap: anywhere;
+ }
+
+ .disclosure[open] > .expandable-content {
+   max-height: min(50vh, 24rem);
+   overflow: auto;
+   scrollbar-gutter: stable;
+ }
+
+ .preview label {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-1);
+ }
+
+ .preview {
+   display: flex;
+   flex-direction: column;
+   align-items: flex-start;
+   gap: var(--sp-2);
+   margin-top: var(--sp-2);
+ }
+
+ .preview p {
+   margin: 0;
+ }
+
+ .labels {
+   display: flex;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+ }
+
+ .lb {
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   border: 0;
+   border-radius: 2px;
+   padding: 0 var(--sp-1);
+   background: var(--surface-2);
+   color: var(--fg-2);
+   white-space: nowrap;
+ }
+
+ /* decision briefs and the Item panel */
+ .btitle {
+   font-size: var(--fs-panel);
+ }
+
+ /* ticket beside the board (components/TicketDetail.tsx) */
+ .tdetail {
+   width: auto;
+   min-width: 0;
+ }
+
+ .tdetail > .ph a {
+   text-decoration: none;
+   font-size: var(--fs-s);
+ }
+
+ .tart {
+   display: grid;
+   gap: var(--sp-3);
+ }
+
+ .thead {
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .tbody {
+   /* a grid item: without this a long code line sets its min-content width and widens the pane */
+   min-width: 0;
+   white-space: pre-wrap;
+   overflow-wrap: anywhere;
+   background: var(--surface-2);
+   border-radius: var(--r-s);
+   padding: var(--sp-2) var(--sp-2);
+   font-size: var(--fs-s);
+ }
+
+ .tlist {
+   list-style: none;
+   margin: 0;
+   padding: 0;
+   display: grid;
+   gap: var(--sp-1);
+   font-size: var(--fs-s);
+ }
+
+ /* in a panel body the list keeps .pb's padding */
+ .pb.tlist {
+   padding: var(--sp-1) var(--sp-3) var(--sp-3);
+ }
+
+ @media (max-width: 999px) {
+   .tdetail {
+     width: auto;
+   }
+ }
+
+ /* read-only config (components/config/ConfigYaml.tsx): a sticky, scrolling code block */
+ .yaml {
+   position: sticky;
+   top: 0;
+   max-height: 70vh;
+   overflow: auto;
+   display: grid;
+   grid-template-columns: auto minmax(0, 1fr);
+   gap: 0 var(--sp-3);
+   padding: var(--sp-2) var(--sp-2);
+   border: 1px solid var(--line);
+   border-radius: var(--r-s);
+   background: var(--bg);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+ }
+
+ /* a row is transparent to the grid: every number shares one column, each beside its own line */
+ .yaml .yrow {
+   display: contents;
+ }
+
+ .yaml .yln {
+   color: var(--muted);
+   text-align: right;
+   white-space: pre;
+   user-select: none;
+ }
+
+ .yaml .ytx {
+   white-space: pre-wrap;
+   overflow-wrap: anywhere;
+   min-width: 0;
+   color: var(--fg);
+ }
+
+ .yk {
+   color: var(--accent);
+ }
+
+ .yv {
+   color: var(--fg);
+ }
+
+ .yc {
+   color: var(--muted);
+ }
+
+ @media (max-width: 999px) {
+   .yaml {
+     position: static;
+   }
+ }
+
+ /* glossary (components/config/Glossary.tsx) */
+ .gloss {
+   display: grid;
+   grid-template-columns: max-content minmax(0, 1fr);
+   gap: var(--sp-1) var(--sp-3);
+   margin: 0;
+   font-size: var(--fs-s);
+ }
+
+ .gloss dt {
+   font-weight: 600;
+   color: var(--fg);
+ }
+
+ .gloss dd {
+   margin: 0;
+   color: var(--fg-2);
+ }
+
+ .gloss code {
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   color: var(--fg);
+   background: var(--surface-2);
+   border-radius: 4px;
+   padding: 0 var(--sp-1);
+ }
+
+ @media (max-width: 760px) {
+   .gloss {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
+
+ /* biome-ignore-all lint/style/noDescendingSpecificity: later rules override earlier ones by order here, as in hud.css */
+ #wifP .agent-link::after {
+   content: "";
+   position: absolute;
+   inset: 0;
+ }
+
+ /* Work in flight: a cell per step, marked as the step bar is (d done, c current, w held) */
+ .wsteps {
+   display: inline-flex;
+   gap: var(--sp-1);
+ }
+
+ .wstep {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   padding: 0 var(--sp-2);
+   border-radius: 4px;
+   font-size: var(--fs-s);
+   color: var(--muted);
+   background: var(--surface-2);
+   border-bottom: 2px solid var(--line-2);
+   white-space: nowrap;
+ }
+
+ .wstep.d {
+   color: var(--fg-2);
+   border-bottom-color: var(--fg-2);
+ }
+
+ .wstep.c {
+   color: var(--fg);
+   border-bottom-color: var(--ok);
+ }
+
+ .wstep.w {
+   color: var(--fg);
+   border-bottom-color: var(--warn-mark);
+   background: var(--warn-soft);
+ }
+
+ .nrow {
+   display: grid;
+   grid-template-columns: auto minmax(0, 1fr);
+   gap: var(--sp-1) var(--sp-2);
+   align-items: start;
+   padding: var(--sp-2) var(--sp-3);
+   border-top: 1px solid var(--line);
+ }
+
+ .nrow > .lamp {
+   margin-top: var(--sp-1);
+ }
+
+ .nrow.acked {
+   opacity: 0.6;
+ }
+
+ .nrow .acts {
+   grid-column: 2;
+   display: flex;
+   gap: var(--sp-1);
+   flex-wrap: wrap;
+ }
+
+ /* What the one "FLIGHT is not triaging" item stands for, listed under it (#758). */
+ .not-triaging-list {
+   list-style: none;
+   margin: var(--sp-1) 0 0;
+   padding: 0;
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .kind {
+   font-size: var(--fs-s);
+   font-weight: 600;
+   color: var(--warn);
+   margin-right: var(--sp-1);
+ }
+
+ .briefgrid {
+   display: grid;
+   grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
+   gap: var(--sp-3);
+ }
+
+ .briefsec {
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 0;
+ }
+
+ .briefsec h3 {
+   margin: 0;
+   font-size: var(--fs);
+   font-weight: 600;
+ }
+
+ .drow {
+   padding: var(--sp-2) var(--sp-3);
+   border-top: 1px solid var(--line);
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .drow .row {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   flex-wrap: wrap;
+ }
+
+ /* FLIGHT page */
+ /* A flight director's console (docs/design/flight-deck.md): hairlines, mono readouts, colour only
+    for state. Selection is an accent edge; the one coloured border is the dock's "Waiting on you". */
+ #page-flight {
+   display: grid;
+   /* A track that may shrink, so a long strip is cut inside it and never widens the page. */
+   grid-template-columns: minmax(0, 1fr);
+   grid-template-rows: auto auto minmax(0, 1fr);
+   gap: var(--sp-3);
+   overflow: hidden;
+   /* The tabs lay out by the page's own width: the dock takes a share of the window. */
+   container: flight / inline-size;
+ }
+
+ /* The status strip: one line of state, wake times, headline and counts over the tabs. The wake line
+    and the headline give way (cut with an ellipsis); the state and the counters never do. */
+ .flight-strip {
+   display: flex;
+   flex-wrap: nowrap;
+   min-width: 0;
+   align-items: center;
+   gap: var(--sp-2) var(--sp-4);
+   padding: var(--sp-2) var(--sp-4);
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r-s);
+ }
+
+ .flight-strip-run {
+   flex: none;
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-2);
+ }
+
+ .flight-strip-wake {
+   color: var(--muted);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   flex: 0 1 auto;
+   min-width: 0;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .flight-strip-headline {
+   flex: 1 1 0;
+   min-width: 0;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .flight-strip-counters {
+   flex: none;
+   display: inline-flex;
+   gap: var(--sp-1);
+ }
+
+ .flight-counter {
+   padding: var(--sp-1) var(--sp-2);
+   color: var(--fg-2);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   background: none;
+   border-color: transparent;
+ }
+
+ .flight-counter b {
+   color: var(--fg);
+   font-size: var(--fs);
+ }
+
+ .flight-counter.tone-warn b {
+   color: var(--warn);
+ }
+
+ .flight-counter:hover {
+   background: var(--accent-soft);
+ }
+
+ /* The tabs scroll sideways rather than wrap; the rule is an inset line so the scroller's
+    clipping keeps the selected tab's edge. */
+ .flight-tabs {
+   display: flex;
+   gap: var(--sp-1);
+   overflow-x: auto;
+   overflow-y: hidden;
+   box-shadow: inset 0 -1px var(--line);
+   scrollbar-width: thin;
+ }
+
+ .flight-tabs button {
+   position: relative;
+   flex: none;
+   display: inline-flex;
+   align-items: baseline;
+   gap: var(--sp-2);
+   min-height: 34px;
+   padding: var(--sp-2) var(--sp-4) var(--sp-2);
+   color: var(--muted);
+   font: 600 var(--fs-s) / var(--lh-s) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+   background: transparent;
+   border: 0;
+   border-radius: 0;
+   transition:
+     color 150ms ease,
+     background-color 150ms ease;
+ }
+
+ .flight-tabs button::after {
+   content: "";
+   position: absolute;
+   right: 0;
+   bottom: 0;
+   left: 0;
+   height: 2px;
+   background: transparent;
+   transition: background-color 150ms ease;
+ }
+
+ .flight-tabs button:hover {
+   color: var(--fg-2);
+   border-color: transparent;
+ }
+
+ .flight-tabs button:hover::after {
+   background: var(--line-2);
+ }
+
+ .flight-tabs button[aria-selected="true"] {
+   color: var(--fg);
+ }
+
+ .flight-tabs button[aria-selected="true"]::after {
+   background: var(--accent);
+ }
+
+ .flight-tab-index {
+   color: var(--muted);
+   font-size: var(--fs-s);
+   font-weight: 500;
+   letter-spacing: 0.04em;
+ }
+
+ .flight-tabs button[aria-selected="true"] .flight-tab-index {
+   color: var(--accent);
+ }
+
+ /* Each tab fits the window where it can; where its panels' minimum heights do not fit, the tab
+    body scrolls rather than cutting the lower panels off. */
+ .flight-tab-body {
+   min-height: 0;
+ }
+
+ .flight-needs,
+ .flight-did,
+ .flight-crew,
+ .flight-knows {
+   overflow: auto;
+ }
+
+ .flight-tab-body[hidden] {
+   display: none;
+ }
+
+ /* Panel headers stay one line: the sub-label is cut rather than pushing the body down. */
+ #page-flight .ph {
+   flex-wrap: nowrap;
+   min-height: 40px;
+ }
+
+ #page-flight .ph h2 {
+   flex: none;
+ }
+
+ #page-flight .ph .sub {
+   min-width: 0;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ /* Repo chips are filled, not outlined. */
+ #page-flight .rchip {
+   color: var(--c, var(--fg-2));
+   background: color-mix(in srgb, var(--c, var(--fg-2)) 14%, transparent);
+   border-color: transparent;
+   border-radius: 3px;
+ }
+
+ .flight-panel-scroll,
+ .flight-knowledge-scroll {
+   flex: 1 1 0;
+   min-height: 0;
+   overflow: auto;
+ }
+
+ .flight-panel-scroll[hidden] {
+   display: none;
+ }
+
+ /* shared readouts */
+ .flight-source {
+   margin: 0;
+   color: var(--muted);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.12em;
+   text-transform: uppercase;
+ }
+
+ .flight-source.think {
+   color: var(--think);
+ }
+
+ .flight-count {
+   letter-spacing: 0;
+   text-transform: none;
+   white-space: nowrap;
+ }
+
+ .flight-mono,
+ .flight-count {
+   color: var(--muted);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   font-variant-numeric: tabular-nums;
+ }
+
+ .flight-subhead {
+   margin: 0;
+   padding: var(--sp-3) var(--sp-3) var(--sp-1);
+   color: var(--fg-2);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+ }
+
+ /* A gap in FLIGHT's records (no next action, no checkpoint): quiet, never an alarm colour. */
+ .flight-gap {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .flight-gap::before {
+   content: "";
+   flex: none;
+   width: 7px;
+   height: 7px;
+   border: 1px dashed currentColor;
+   border-radius: 50%;
+ }
+
+ button.flight-link {
+   padding: var(--sp-1) var(--sp-1);
+   color: var(--accent);
+   font: 600 var(--fs-s) / var(--lh-s) var(--mono);
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+ }
+
+ button.flight-link:hover {
+   background: var(--accent-soft);
+   border-color: transparent;
+ }
+
+ /* FLIGHT's tables are real tables laid out as grids: each row is a grid, its cells the items. */
+ .wif-table,
+ .flight-plan-table,
+ .flight-outcome-table,
+ .wif-table > :is(thead, tbody),
+ .flight-plan-table > :is(thead, tbody),
+ .flight-outcome-table > :is(thead, tbody) {
+   display: block;
+ }
+
+ .wif-table > thead,
+ .flight-plan-table > thead,
+ .flight-outcome-table > thead {
+   position: sticky;
+   top: 0;
+   z-index: 2;
+ }
+
+ /* Undo the global th/td look; element-level specificity, so each column's class still wins. */
+ :where(.wif-table, .flight-plan-table, .flight-outcome-table) :is(th, td) {
+   min-width: 0;
+   padding: 0;
+   font: inherit;
+   text-align: left;
+   vertical-align: top;
+   white-space: normal;
+   border: 0;
+ }
+
+ /* Delivery board: the delivery path is a step track on one line */
+ .wif-table {
+   min-width: 860px;
+ }
+
+ .wif-table-head,
+ .wif-row {
+   display: grid;
+   grid-template-columns:
+     minmax(92px, 0.5fr) minmax(150px, 1.1fr) minmax(220px, 1.4fr)
+     minmax(120px, 0.8fr) minmax(120px, 0.9fr) minmax(110px, 0.8fr);
+   column-gap: var(--sp-3);
+   align-items: start;
+ }
+
+ .wif-table-head {
+   padding: var(--sp-2) var(--sp-3);
+   color: var(--muted);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+   background: var(--surface);
+   border-bottom: 1px solid var(--line);
+ }
+
+ #wifP .wif-row {
+   padding: var(--sp-3) var(--sp-3);
+   border-bottom: 1px solid var(--line);
+   border-radius: 0;
+   transition: background-color 150ms ease;
+ }
+
+ #wifP .wif-row:hover {
+   background: color-mix(in srgb, var(--surface-2) 70%, transparent);
+   border-radius: 0;
+ }
+
+ .wif-seat {
+   display: grid;
+   gap: var(--sp-1);
+   justify-items: start;
+   min-width: 0;
+ }
+
+ .wif-work {
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 0;
+ }
+
+ .wif-title {
+   display: block;
+   color: var(--fg);
+   font-size: var(--fs);
+   font-weight: 600;
+ }
+
+ .wif-meta {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: baseline;
+   min-width: 0;
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .wif-meta > .rref {
+   flex: none;
+ }
+
+ .wif-doing {
+   display: block;
+ }
+
+ .wif-branch {
+   display: block;
+   color: var(--muted);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+ }
+
+ .wif-stage {
+   display: grid;
+   gap: var(--sp-1);
+   justify-items: start;
+   min-width: 0;
+ }
+
+ .wif-stage > .rref {
+   font-size: var(--fs-s);
+ }
+
+ .wif-next {
+   display: grid;
+   gap: var(--sp-1);
+   min-width: 0;
+   font-size: var(--fs-s);
+ }
+
+ .wif-next-text {
+   display: -webkit-box;
+   overflow: hidden;
+   color: var(--fg);
+   line-height: var(--lh);
+   -webkit-box-orient: vertical;
+   -webkit-line-clamp: 2;
+   line-clamp: 2;
+ }
+
+ .wif-checkpoint {
+   color: var(--fg-2);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   font-variant-numeric: tabular-nums;
+ }
+
+ .wif-stuck,
+ .wif-said {
+   min-width: 0;
+   font-size: var(--fs-s);
+   overflow-wrap: anywhere;
+ }
+
+ .wif-stuck-reason {
+   display: grid;
+   justify-items: start;
+   gap: var(--sp-1);
+ }
+
+ .wif-stuck-reason .expandable-text {
+   line-height: var(--lh);
+ }
+
+ .wif-stuck-reason .sm {
+   margin-top: 0;
+ }
+
+ #wifP .wsteps {
+   display: flex;
+   flex-wrap: nowrap;
+   gap: var(--sp-1);
+   width: 100%;
+   min-width: 0;
+ }
+
+ #wifP .wstep {
+   position: relative;
+   display: block;
+   flex: 0 1 auto;
+   min-width: 2.5em;
+   padding: var(--sp-2) 0 0 0;
+   overflow: hidden;
+   color: var(--muted);
+   font-size: var(--fs-s);
+   font-weight: 500;
+   line-height: var(--lh-s);
+   text-overflow: ellipsis;
+   white-space: nowrap;
+   background: none;
+   border: 0;
+   border-radius: 0;
+ }
+
+ #wifP .wstep::before {
+   content: "";
+   position: absolute;
+   top: 0;
+   right: 0;
+   left: 0;
+   height: 3px;
+   background: var(--line-2);
+ }
+
+ #wifP .wstep.d {
+   color: var(--fg-2);
+ }
+
+ #wifP .wstep.d::before {
+   background: color-mix(in srgb, var(--fg-2) 55%, transparent);
+ }
+
+ #wifP .wstep.c,
+ #wifP .wstep.w {
+   flex-shrink: 0;
+ }
+
+ #wifP .wstep.c {
+   color: var(--fg);
+   font-weight: 600;
+ }
+
+ #wifP .wstep.c::before {
+   background: var(--accent);
+   box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 55%, transparent);
+ }
+
+ #wifP .wstep.w {
+   color: var(--warn);
+   font-weight: 600;
+ }
+
+ #wifP .wstep.w::before {
+   background: var(--warn-mark);
+ }
+
+ #wifP .wstep .titer {
+   padding: 0 0 0 0;
+   color: var(--accent);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   vertical-align: super;
+   background: none;
+ }
+
+ /* Needs you */
+ .flight-needs {
+   display: grid;
+   grid-template-rows: minmax(260px, 2fr) minmax(440px, auto) minmax(170px, 1fr) minmax(130px, 0.6fr);
+   gap: var(--sp-3);
+   min-height: 0;
+ }
+
+ .flight-needs-groups {
+   display: grid;
+   grid-template-columns: repeat(4, minmax(0, 1fr));
+   gap: var(--sp-3);
+   min-height: 0;
+ }
+
+ .flight-summary,
+ .flight-summary section {
+   min-width: 0;
+   list-style: none;
+ }
+
+ .flight-summary {
+   overflow-wrap: anywhere;
+ }
+
+ .flight-summary > .note {
+   margin: 0;
+   padding: var(--sp-2) var(--sp-3);
+ }
+
+ .flight-plan-intro {
+   display: flex;
+   gap: var(--sp-3);
+   align-items: baseline;
+   padding: var(--sp-2) var(--sp-3);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .flight-plan-intro h3 {
+   flex: none;
+   margin: 0;
+   color: var(--fg-2);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+ }
+
+ .flight-plan-intro p {
+   flex: 1 1 auto;
+   min-width: 0;
+   margin: 0;
+   overflow: hidden;
+   color: var(--muted);
+   font-size: var(--fs-s);
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .flight-plan-count {
+   flex: none;
+   color: var(--fg-2);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   font-variant-numeric: tabular-nums;
+ }
+
+ .flight-plan-table {
+   /* the rows' grid minimum: 850px of tracks, six 14px gaps and 28px of padding */
+   min-width: 962px;
+ }
+
+ .flight-plan-head,
+ .flight-plan-row,
+ .flight-outcome-head,
+ .flight-outcome-row {
+   display: grid;
+   column-gap: var(--sp-3);
+   align-items: start;
+ }
+
+ .flight-plan-head,
+ .flight-plan-row {
+   grid-template-columns:
+     76px minmax(170px, 1.3fr) 96px 104px minmax(180px, 1.3fr)
+     minmax(160px, 1fr) 64px;
+ }
+
+ .flight-plan-head,
+ .flight-outcome-head {
+   padding: var(--sp-2) var(--sp-3);
+   color: var(--muted);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+   background: var(--surface);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .flight-plan-head > :last-child,
+ .flight-outcome-head > :last-child {
+   text-align: right;
+ }
+
+ .flight-plan-row,
+ .flight-outcome-row {
+   padding: var(--sp-3) var(--sp-3);
+   font-size: var(--fs-s);
+   border-bottom: 1px solid var(--line);
+   transition: background-color 150ms ease;
+ }
+
+ .flight-plan-row:hover,
+ .flight-outcome-row:hover {
+   background: color-mix(in srgb, var(--surface-2) 70%, transparent);
+ }
+
+ .flight-plan-row > td,
+ .flight-outcome-row > td {
+   min-width: 0;
+ }
+
+ .flight-plan-horizon {
+   color: var(--fg-2);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+ }
+
+ .flight-plan-work,
+ .flight-plan-checkpoint,
+ .flight-outcome-row > td:first-child {
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .flight-plan-work > b,
+ .flight-outcome-row b {
+   color: var(--fg);
+   font-size: var(--fs);
+   line-height: var(--lh);
+ }
+
+ .flight-plan-next {
+   color: var(--fg);
+   line-height: var(--lh);
+ }
+
+ .flight-plan-checkpoint {
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+ }
+
+ .flight-plan-refs,
+ .flight-refs {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-2);
+   color: var(--muted);
+ }
+
+ .flight-plan-age,
+ .flight-outcome-at {
+   color: var(--fg-2);
+   font: 500 var(--fs-micro) / var(--lh-micro) var(--mono);
+   font-variant-numeric: tabular-nums;
+   text-align: right;
+   white-space: nowrap;
+ }
+
+ #page-flight .askcards,
+ #page-flight .tlist {
+   gap: 0;
+ }
+
+ #page-flight .askcards:empty {
+   display: none;
+ }
+
+ /* the dock already carries the one coloured edge for what waits on the operator */
+ #page-flight .askcard {
+   padding: var(--sp-2) var(--sp-2);
+   border-color: var(--line);
+   border-radius: 2px;
+ }
+
+ #askP .drow {
+   gap: var(--sp-1);
+   padding: var(--sp-2) var(--sp-3);
+ }
+
+ #askP .drow:first-child {
+   border-top: 0;
+ }
+
+ #askP .drow .row {
+   flex-wrap: nowrap;
+   align-items: flex-start;
+ }
+
+ #askP .drow .row > .min0 {
+   flex: 1 1 auto;
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+ }
+
+ #askP .drow .row > .spacer {
+   display: none;
+ }
+
+ #askP .drow > .s {
+   color: var(--fg-2);
+   line-height: var(--lh);
+ }
+
+ #page-flight .incoming-row,
+ #page-flight .watch-row {
+   padding: var(--sp-2) 0;
+   border-top: 1px solid var(--line);
+ }
+
+ #page-flight .incoming-row:first-child,
+ #page-flight .watch-row:first-child {
+   border-top: 0;
+ }
+
+ /* What FLIGHT knows */
+ .flight-knows {
+   display: grid;
+   grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
+   grid-template-rows: max-content minmax(0, 1fr);
+   gap: var(--sp-3);
+   min-height: 0;
+ }
+
+ .flight-knows-orders {
+   grid-column: 1 / -1;
+   display: grid;
+   grid-template-columns: repeat(2, minmax(0, 1fr));
+   gap: var(--sp-3);
+ }
+
+ .flight-notes .flight-knowledge-scroll > p.note:first-child {
+   max-width: none;
+   margin: 0;
+   padding: var(--sp-2) var(--sp-4);
+   color: var(--muted);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .flight-notebook-index {
+   position: sticky;
+   top: 0;
+   z-index: 1;
+   display: flex;
+   flex-wrap: wrap;
+   margin: 0;
+   padding: 0 var(--sp-2);
+   background: var(--surface);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .flight-notebook-index a {
+   position: relative;
+   padding: var(--sp-2) var(--sp-2);
+   color: var(--fg-2);
+   font: 600 var(--fs-s) / var(--lh-s) var(--mono);
+   letter-spacing: 0.08em;
+   text-decoration: none;
+   text-transform: uppercase;
+ }
+
+ .flight-notebook-index a:hover {
+   color: var(--accent);
+ }
+
+ .flight-knows .briefgrid {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr);
+   gap: 0;
+   padding: 0;
+ }
+
+ .flight-knows .briefsec {
+   display: grid;
+   gap: var(--sp-2);
+   align-content: start;
+   padding: var(--sp-3) var(--sp-4) var(--sp-4);
+   scroll-margin-top: 40px;
+   background: none;
+   border: 0;
+   border-bottom: 1px solid var(--line);
+   border-radius: 0;
+ }
+
+ .flight-knows .briefsec:target {
+   background: var(--accent-soft);
+   box-shadow: inset 2px 0 var(--accent);
+ }
+
+ .flight-note-heading {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-3);
+   align-items: baseline;
+   justify-content: space-between;
+ }
+
+ .flight-note-heading h3 {
+   margin: 0;
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+ }
+
+ .flight-note-heading h3 a {
+   display: inline-flex;
+   align-items: center;
+   min-width: 24px;
+   min-height: 24px;
+   font-size: var(--fs-s);
+   color: var(--fg);
+   text-decoration: none;
+ }
+
+ .flight-note-heading h3 a::before {
+   color: var(--accent);
+   content: "§ ";
+ }
+
+ .flight-note-heading .s {
+   color: var(--muted);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+
+ .flight-knows .briefsec .md-txt {
+   max-width: 80ch;
+   color: var(--fg);
+   font-size: var(--fs);
+   line-height: var(--lh);
+ }
+
+ .flight-markdown-source summary {
+   display: inline-flex;
+   align-items: center;
+   min-height: 24px;
+   color: var(--muted);
+   font: 600 var(--fs-s) / var(--lh-s) var(--mono);
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+   cursor: pointer;
+ }
+
+ .flight-markdown-source summary:hover {
+   color: var(--accent);
+ }
+
+ .flight-markdown-source pre {
+   max-height: 15rem;
+   margin: var(--sp-2) 0 0;
+   padding: var(--sp-2) var(--sp-3);
+   overflow: auto;
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   white-space: pre-wrap;
+   background: var(--bg);
+   border: 1px solid var(--line);
+   border-radius: 2px;
+ }
+
+ .flight-memory .flight-knowledge-scroll > .pb {
+   padding: var(--sp-2) var(--sp-4) var(--sp-3);
+ }
+
+ .flight-memory .flight-knowledge-scroll > .pb > .note:first-child {
+   margin: 0 0 var(--sp-2);
+   color: var(--muted);
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+ }
+
+ #page-flight .memory-repo {
+   grid-template-columns: auto minmax(0, 1fr);
+   align-items: center;
+   gap: var(--sp-2);
+   color: var(--fg-2);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+ }
+
+ #page-flight .memory-repo select {
+   font: var(--fs) / var(--lh) var(--sans, inherit);
+   letter-spacing: 0;
+   text-transform: none;
+ }
+
+ .flight-memory section > h3 {
+   margin: var(--sp-3) 0 0;
+   color: var(--fg-2);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+ }
+
+ /* What FLIGHT did */
+ .flight-did {
+   display: grid;
+   grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
+   gap: var(--sp-3);
+   min-height: 0;
+ }
+
+ /* The side panels take their content's height and the column scrolls, so the outcomes table shows
+    all its rows; the lists under it are capped and scroll inside. */
+ .flight-did-side {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-3);
+   min-height: 0;
+   overflow: auto;
+ }
+
+ .flight-did-side > * {
+   flex: none;
+ }
+
+ .flight-did-side .flight-panel-scroll {
+   flex: none;
+   max-height: 320px;
+   overflow-x: hidden;
+   overflow-y: auto;
+ }
+
+ .flight-filters {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-2);
+   padding: var(--sp-2) var(--sp-4);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .flight-filters input[type="search"] {
+   flex: 1 1 200px;
+   min-width: 0;
+ }
+
+ /* Crew & board */
+ .flight-crew {
+   display: grid;
+   grid-template-rows: minmax(260px, 2fr) minmax(180px, 0.8fr) minmax(130px, 0.5fr);
+   gap: var(--sp-3);
+   min-height: 0;
+ }
+
+ .flight-tiles {
+   display: grid;
+   grid-template-columns: repeat(auto-fit, minmax(min(120px, 100%), 1fr));
+   gap: var(--sp-2);
+   margin: var(--sp-3) 0;
+ }
+
+ .flight-tiles > div {
+   min-width: 0;
+   padding: var(--sp-2);
+   border: 1px solid var(--line);
+   border-radius: 2px;
+ }
+
+ .flight-tiles dt {
+   color: var(--fg-2);
+ }
+
+ .flight-tiles dd {
+   min-width: 0;
+   margin: 0;
+   font-family: var(--display);
+   font-size: var(--fs-title);
+ }
+
+ #outcomesP .flight-tiles {
+   grid-template-columns: repeat(4, minmax(0, 1fr));
+   gap: 0;
+   margin: 0;
+   border-bottom: 1px solid var(--line);
+ }
+
+ #outcomesP .flight-tiles > div {
+   display: grid;
+   gap: var(--sp-1);
+   padding: var(--sp-2) var(--sp-3) var(--sp-3);
+   border: 0;
+   border-right: 1px solid var(--line);
+   border-radius: 0;
+ }
+
+ #outcomesP .flight-tiles > div:last-child {
+   border-right: 0;
+ }
+
+ #outcomesP .flight-tiles dt {
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   letter-spacing: 0.1em;
+   overflow-wrap: anywhere;
+   text-transform: uppercase;
+ }
+
+ #outcomesP .flight-tiles dd {
+   color: var(--fg);
+   font: 600 var(--fs-title) / var(--lh-title) var(--mono);
+   font-variant-numeric: tabular-nums;
+ }
+
+ .flight-tile-btn {
+   min-width: 24px;
+   min-height: 24px;
+   padding: 0 var(--sp-1);
+   margin: 0 0 0 calc(-1 * var(--sp-1));
+   border: 1px solid transparent;
+   background: none;
+   color: inherit;
+   font: inherit;
+   cursor: pointer;
+ }
+
+ .flight-tile-toggle {
+   cursor: pointer;
+ }
+
+ .flight-tile-toggle:has(.flight-tile-btn[aria-pressed="true"]) {
+   box-shadow: inset 0 0 0 1px var(--accent);
+ }
+
+ /* The outcomes fit their panel: the text columns share what is left and wrap, so the table never
+    scrolls sideways, and its panel grows to show the rows. */
+ .flight-outcome-head,
+ .flight-outcome-row {
+   grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.2fr) minmax(0, 1fr) 96px;
+   overflow-wrap: anywhere;
+ }
+
+ #outcomesP .flight-panel-scroll {
+   max-height: none;
+ }
+
+ .flight-outcome-row .fg2 {
+   color: var(--muted);
+ }
+
+ #decidedP .drow {
+   padding: var(--sp-2) var(--sp-3);
+ }
+
+ #decidedP .drow:first-child {
+   border-top: 0;
+ }
+
+ .flight-log .dmsg {
+   padding: var(--sp-2) var(--sp-3);
+   border-bottom: 1px solid var(--line);
+ }
+
+ .flight-log .dmsg .who {
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+
+ @media (max-width: 1439px) {
+   /* Four groups side by side get too narrow here: two by two, each tall enough for its rows. */
+   .flight-needs {
+     grid-template-rows: minmax(260px, 2fr) minmax(440px, auto) minmax(300px, 1.3fr) minmax(
+         130px,
+         0.6fr
+       );
+   }
+   .flight-needs-groups {
+     grid-template-columns: repeat(2, minmax(0, 1fr));
+     grid-auto-rows: minmax(130px, 1fr);
+   }
+ }
+
+ @container flight (width < 900px) {
+   .flight-needs {
+     grid-template-rows: minmax(240px, 1fr) auto auto auto;
+   }
+   .flight-needs-groups,
+   .flight-knows-orders {
+     grid-template-columns: minmax(0, 1fr);
+     grid-template-rows: none;
+     grid-auto-rows: minmax(160px, auto);
+   }
+   .flight-did,
+   .flight-knows {
+     grid-template-columns: minmax(0, 1fr);
+     grid-auto-rows: minmax(320px, auto);
+   }
+ }
+
+ .sittext {
+   font-size: var(--fs-panel);
+   line-height: var(--lh-panel);
+   max-width: 110ch;
+ }
+
+ .askcards {
+   display: grid;
+   grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+   gap: var(--sp-2);
+   padding: var(--sp-2) var(--sp-3) var(--sp-3);
+ }
+
+ .askcard {
+   display: grid;
+   gap: var(--sp-1);
+   border: 1px solid var(--warn-mark);
+   border-radius: var(--r-s);
+   padding: var(--sp-1) var(--sp-2);
+ }
+
+ .askcard blockquote {
+   margin: 0;
+   border-left: 2px solid var(--line);
+   padding-left: var(--sp-2);
+ }
+
+ @media (max-width: 999px), (max-height: 559px) {
+   #page-flight {
+     display: flex;
+     flex-direction: column;
+     overflow: visible;
+   }
+   .flight-needs,
+   .flight-needs-groups,
+   .flight-did,
+   .flight-did-side,
+   .flight-crew,
+   .flight-knows,
+   .flight-knows-orders {
+     display: flex;
+     flex-direction: column;
+     overflow: visible;
+   }
+   /* Panels take their content's height here, so a body sized from zero would overlap the next. */
+   .flight-knowledge-scroll {
+     flex: none;
+     overflow: visible;
+   }
+   /* The page scrolls down; a table wider than its panel still scrolls sideways inside it. */
+   .flight-panel-scroll {
+     flex: none;
+     overflow-x: auto;
+     overflow-y: hidden;
+   }
+   #outcomesP .flight-tiles {
+     grid-template-columns: repeat(auto-fit, minmax(min(120px, 100%), 1fr));
+   }
+   .flight-knows .briefgrid {
+     grid-template-columns: minmax(0, 1fr);
+   }
+ }
+
+ .watch-row {
+   display: flex;
+   align-items: baseline;
+   gap: var(--sp-2);
+   padding-block: var(--sp-2);
+ }
+
+ .watch-row .min0,
+ .incoming-row {
+   overflow-wrap: anywhere;
+ }
+
+ .incoming-row {
+   padding-block: var(--sp-2);
+ }
+
+ .draft-row {
+   overflow-wrap: anywhere;
+ }
+
+ .draft-row.acked {
+   opacity: 0.6;
+ }
+
+ .draft-row textarea {
+   width: 100%;
+   min-width: 0;
+ }
+
+ .draft-row .chipref {
+   white-space: normal;
+ }
+
+ .draft-row .pre {
+   white-space: pre-wrap;
+ }
+
+ #cHandled .nrow > div {
+   grid-column: 1 / -1;
+   min-width: 0;
+ }
+
+ /* FLIGHT's notes open at full height, like the brief panel they replaced. */
+ .flight-notes .disclosure[open] > .expandable-content,
+ .flight-memory > .disclosure[open] > .expandable-content {
+   max-height: none;
+   overflow: visible;
+ }
+
+ .flight-notes > .disclosure > summary,
+ .flight-memory > .disclosure > summary {
+   padding: var(--sp-3) var(--sp-3);
+   font-weight: 600;
+ }
+
+ .flight-notes h2,
+ .flight-memory h2 {
+   display: inline;
+ }
+
+ .flight-memory,
+ .flight-memory section,
+ .memory-note {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .memory-list {
+   list-style: none;
+   padding: 0;
+ }
+
+ .memory-note {
+   padding: var(--sp-3) 0;
+   border-top: 1px solid var(--line);
+ }
+
+ .memory-note .expandable-text {
+   white-space: pre-wrap;
+ }
+
+ .memory-form,
+ .memory-form label,
+ .memory-repo {
+   display: grid;
+   min-width: 0;
+   gap: var(--sp-1);
+   margin-bottom: var(--sp-3);
+ }
+
+ .flight-memory input,
+ .flight-memory select,
+ .flight-memory textarea {
+   width: 100%;
+   min-width: 0;
+   max-width: 100%;
+ }
+
+ .flight-memory textarea {
+   resize: vertical;
+ }
+
+ @media (max-width: 760px) {
+   .wif-table-head {
+     display: none;
+   }
+   .wif-row {
+     grid-template-columns: minmax(0, 1fr) auto;
+   }
+   .wif-work,
+   .wif-stage {
+     grid-column: 1 / -1;
+   }
+   .wif-elapsed {
+     grid-column: 2;
+     grid-row: 1;
+   }
+ }
+
+ /* An ask's Full brief toggle sits at the start of its row, not centred in the grid. */
+ .drow .fullbrief {
+   justify-self: start;
+ }
+
+ .flight-prompt-wakes {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-4);
+   margin: 0;
+   padding: var(--sp-4);
+   list-style: none;
+ }
+
+ .flight-prompt-wakes h3 {
+   margin: 0 0 var(--sp-2);
+   font-weight: 600;
+ }
+
+ #prFlowP {
+   min-width: 0;
+ }
+ .pr-flow-summary {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-3) var(--sp-6);
+   margin: 0;
+   padding: var(--sp-3);
+   border-bottom: 1px solid var(--line);
+ }
+ .pr-flow-summary > div {
+   display: grid;
+   align-content: start;
+   gap: var(--sp-1);
+ }
+ .pr-flow-summary dt {
+   font-size: var(--fs-s);
+   color: var(--muted);
+ }
+ .pr-flow-summary dd {
+   margin: 0;
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+   font-variant-numeric: tabular-nums;
+ }
+ .pr-flow-summary .pr-flow-median dd {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-3);
+ }
+ .pr-flow-scroll {
+   min-height: 0;
+   max-height: 480px;
+   overflow: auto;
+   scrollbar-gutter: stable;
+ }
+ .pr-flow-table {
+   width: 100%;
+   min-width: 980px;
+   table-layout: fixed;
+   border-collapse: collapse;
+ }
+ .pr-flow-table col:nth-child(1) {
+   width: 25%;
+ }
+ .pr-flow-table col:nth-child(2) {
+   width: 15%;
+ }
+ .pr-flow-table col:nth-child(3) {
+   width: 15%;
+ }
+ .pr-flow-table col:nth-child(4) {
+   width: 19%;
+ }
+ .pr-flow-table col:nth-child(5) {
+   width: 10%;
+ }
+ .pr-flow-table col:nth-child(6) {
+   width: 16%;
+ }
+ .pr-flow-table th {
+   position: sticky;
+   top: 0;
+   z-index: 1;
+   background: var(--surface-2);
+   text-align: left;
+   font-weight: 500;
+   font-size: var(--fs-s);
+ }
+ .pr-flow-table th,
+ .pr-flow-table td {
+   padding: var(--sp-2) var(--sp-3);
+   border-bottom: 1px solid var(--line);
+   vertical-align: top;
+   overflow-wrap: anywhere;
+   white-space: normal;
+ }
+ .pr-flow-table td {
+   font-size: var(--fs);
+ }
+ .pr-flow-table ul {
+   margin: 0;
+   padding: 0;
+   list-style: none;
+   display: grid;
+   gap: var(--sp-1);
+ }
+ .pr-flow-title {
+   margin-top: var(--sp-1);
+ }
+ .pr-flow-note {
+   font-size: var(--fs-s);
+   color: var(--muted);
+ }
+ .pr-flow-ticket,
+ .pr-flow-actor {
+   display: block;
+   margin-top: var(--sp-1);
+ }
+ .pr-flow-age > * {
+   display: block;
+ }
+ .pr-flow-age strong {
+   font-weight: 500;
+ }
+ .pr-flow-warn {
+   background: var(--warn-soft);
+   box-shadow: inset 2px 0 var(--warn-mark);
+ }
+ .pr-flow-crit {
+   background: var(--crit-soft);
+   box-shadow: inset 2px 0 var(--crit);
+ }
+ .pr-flow-warn .pr-flow-note {
+   color: var(--warn);
+ }
+ .pr-flow-crit .pr-flow-note {
+   color: var(--crit);
+ }
+
+ .pr-flow-table td > a,
+ .pr-flow-table li > a {
+   display: inline-flex;
+   align-items: center;
+   min-width: 24px;
+   min-height: 24px;
+ }
+
