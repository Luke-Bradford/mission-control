+
+ .msg.tagged {
+   background: var(--warn-soft);
+ }
+
+ .msg.mine .from b {
+   color: var(--accent);
+ }
+
+ .msg .from {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   flex-wrap: wrap;
+   font-size: var(--fs-s);
+   color: var(--muted);
+ }
+
+ .msg .body {
+   overflow-wrap: anywhere;
+ }
+
+ .dock .panel {
+   height: 100%;
+ }
+
+ .dmsgs {
+   flex: 1;
+   min-height: 0;
+   overflow: auto;
+   padding: var(--sp-1) 0;
+ }
+
+ .dmsg {
+   padding: var(--sp-1) var(--sp-3);
+   display: grid;
+   gap: 0;
+ }
+
+ .dmsg .who {
+   color: var(--muted);
+   font-size: var(--fs-s);
+   font-weight: 500;
+ }
+
+ .dmsg .txt {
+   overflow-wrap: anywhere;
+   white-space: pre-wrap;
+ }
+
+ .dmsg.you .who,
+ .dmsg.you .txt {
+   color: var(--accent);
+ }
+
+ .dmsg.hub .txt {
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ .dmsg.pending {
+   opacity: 0.7;
+ }
+
+ .dmsg.flight .md-txt {
+   white-space: normal;
+   max-width: 62ch;
+   line-height: var(--lh);
+ }
+
+ .dmsg.flight .md-txt .md strong {
+   color: var(--accent);
+ }
+
+ .note.err {
+   color: var(--crit);
+   width: 100%;
+ }
+
+ /* instruments: mono ticks, dashed grid, a solid axis and a "now" cursor (hud/charts) */
+ .ct {
+   fill: var(--muted);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+
+ .ct.now {
+   fill: var(--accent);
+ }
+
+ .stats {
+   display: grid;
+   grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
+   gap: var(--sp-2);
+ }
+
+ .stat2 {
+   background: var(--surface-2);
+   border-radius: var(--r-s);
+   padding: var(--sp-2) var(--sp-2);
+   display: grid;
+   gap: 0;
+ }
+
+ .stat2 b {
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+ }
+
+ .stat2 span {
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+
+ td.r,
+ th.r {
+   text-align: right;
+ }
+
+ td.wrap {
+   white-space: normal;
+ }
+
+ .tw {
+   overflow-x: auto;
+ }
+
+ /* setup › sessions: a crew session's top folders and who owns each */
+ .tiles {
+   list-style: none;
+   margin: var(--sp-2) 0 0;
+   padding: 0;
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1);
+ }
+
+ .tiles .tile {
+   position: relative;
+   min-width: 0;
+   max-width: 100%;
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+   padding: var(--sp-1) var(--sp-2);
+   border: 1px solid var(--line);
+   border-radius: var(--r-s);
+ }
+
+ .tiles .tile.stray {
+   border-color: var(--crit);
+ }
+
+ /* setup › repos: the add-a-repo form and its preview */
+ .setup-repos {
+   display: grid;
+   gap: var(--sp-3);
+   width: 100%;
+ }
+
+ .bsec {
+   font-size: var(--fs-s);
+   font-weight: 600;
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   color: var(--muted);
+   margin-top: var(--sp-1);
+ }
+
+ /* catch-up: every item brought to you starts with context */
+ .ctx {
+   display: grid;
+   gap: var(--sp-1);
+   padding: var(--sp-2) var(--sp-2);
+   border: 1px solid var(--line-2);
+   border-radius: var(--r-s);
+   background: var(--surface);
+ }
+
+ .ctxline {
+   display: flex;
+   gap: var(--sp-2);
+   align-items: baseline;
+   flex-wrap: wrap;
+   font-size: var(--fs-s);
+ }
+
+ .rules {
+   margin: var(--sp-2) 0 0;
+   padding-left: var(--sp-4);
+   font-size: var(--fs-s);
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ .modal {
+   position: fixed;
+   inset: 0;
+   background: var(--scrim);
+   display: grid;
+   place-items: center;
+   z-index: 35;
+   padding: var(--sp-4);
+ }
+
+ .modal .panel {
+   width: min(720px, 100%);
+   max-height: 86vh;
+ }
+
+ .modal pre {
+   white-space: pre-wrap;
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   margin: 0;
+   color: var(--fg);
+ }
+
+ .keys {
+   color: var(--muted);
+   font-size: var(--fs-s);
+   display: flex;
+   gap: var(--sp-3);
+   flex-wrap: wrap;
+   align-items: center;
+ }
+
+ .tsec {
+   display: grid;
+   gap: var(--sp-1);
+ }
+
+ @media (max-width: 999px), (max-height: 559px) {
+   .col {
+     overflow: visible;
+   }
+   .col > #agentsP,
+   .col > #actP {
+     flex: none;
+     min-height: 0;
+   }
+   #actP .scroll {
+     max-height: 460px;
+   }
+   #stream {
+     max-height: 60vh;
+   }
+ }
+
+ /* Item panel: the loop's own words keep their line breaks */
+ .brief {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr);
+   gap: var(--sp-1);
+ }
+
+ .qtext {
+   min-width: 0;
+   white-space: pre-wrap;
+   overflow-wrap: anywhere;
+ }
+
+ /* Markdown in agent text: wraps inside its column, code scrolls inside its block */
+ .md {
+   min-width: 0;
+   white-space: normal;
+   overflow-wrap: anywhere;
+ }
+
+ .md p {
+   margin: 0 0 var(--sp-1);
+   white-space: pre-wrap;
+ }
+
+ .md > :last-child {
+   margin-bottom: 0;
+ }
+
+ .md ul,
+ .md ol {
+   margin: 0 0 var(--sp-1);
+   padding-left: var(--sp-4);
+ }
+
+ .md li ul {
+   margin: var(--sp-1) 0 0;
+ }
+
+ .md code,
+ .rsummary code,
+ .nrow code,
+ .nowt code,
+ .needpart code,
+ .arow code,
+ .btitle code,
+ .opt code {
+   font-family: var(--mono);
+   font-size: inherit;
+ }
+
+ .md pre.md-code {
+   margin: 0 0 var(--sp-1);
+   max-width: 100%;
+   overflow-x: auto;
+   white-space: pre;
+   overflow-wrap: normal;
+ }
+
+ .ev .txt .md pre {
+   color: var(--fg-2);
+ }
+
+ .thread .doing {
+   min-width: 0;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ details.guard > summary {
+   cursor: pointer;
+   padding: var(--sp-2) var(--sp-3);
+   font-size: var(--fs-s);
+   color: var(--muted);
+ }
+
+ .person-choices {
+   display: grid;
+   overflow: auto;
+   min-height: 0;
+ }
+
+ .person-choices .optlist,
+ .person-choices textarea {
+   width: 100%;
+   min-width: 0;
+ }
+
+ .person-choices .opt {
+   min-width: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .person-choices textarea {
+   min-height: 6em;
+ }
+
+ #dsForm,
+ #dsDiscussionForm {
+   flex-wrap: wrap;
+ }
+
+ #dsForm input,
+ #dsDiscussionForm input {
+   min-width: 0;
+   flex: 1 1 160px;
+ }
+
+ #discuss .brief,
+ #discuss .opt,
+ #discuss .ctx {
+   overflow-wrap: anywhere;
+ }
+
+ #discuss .panel {
+   max-height: 86vh;
+   overflow: hidden;
+ }
+
+ #discuss .ph {
+   flex: none;
+ }
+
+ #discuss .item-body {
+   min-height: 0;
+   overflow: auto;
+   overflow-anchor: none;
+ }
+
+ #discuss .expandable.open .expandable-content {
+   max-height: none;
+   overflow: visible;
+ }
+
+ #discuss .dmsgs {
+   overflow: visible;
+ }
+
+ .item-conversation > summary {
+   margin: var(--sp-2) var(--sp-3);
+ }
+
+ .brief-section {
+   min-width: 0;
+ }
+
+ .brief-section .chipref {
+   white-space: normal;
+   overflow-wrap: anywhere;
+ }
+
+ .brief-refs {
+   display: flex;
+   flex-wrap: wrap;
+   gap: var(--sp-1);
+ }
+
+ .brief-section .bsec {
+   margin: 0 0 var(--sp-1);
+ }
+
+ .answer-heading {
+   margin: var(--sp-2) var(--sp-3);
+ }
+
+ .option-pick {
+   width: 100%;
+   text-align: left;
+   white-space: normal;
+ }
+
+ .option-pick::after {
+   content: "";
+   position: absolute;
+   inset: 0;
+ }
+
+ /* The whole card is the target, so the whole card shows keyboard focus. */
+ .option-pick:focus-visible {
+   outline: none;
+ }
+
+ .opt:has(.option-pick:focus-visible) {
+   outline: 2px solid var(--accent);
+   outline-offset: 1px;
+ }
+
+ .opt .expandable,
+ .opt .expandable > .sm,
+ .opt a {
+   position: relative;
+   z-index: 1;
+ }
+
+ #discuss .opt .pill {
+   justify-self: start;
+ }
+
+ .access-preferences {
+   display: grid;
+   gap: var(--sp-2);
+ }
+
+ .access-preferences input[type="time"] {
+   max-width: 100%;
+ }
+
+ /* the severity word in the Review pane */
+ .map-severity {
+   display: inline-block;
+   padding: 0 var(--sp-1);
+   border-radius: 2px;
+   font-size: var(--fs-s);
+ }
+ .map-lens .map-severity-critical {
+   color: var(--crit);
+   background: var(--crit-soft);
+ }
+ .map-lens .map-severity-important {
+   color: var(--warn);
+   background: var(--warn-soft);
+ }
+ .map-lens .map-severity-minor {
+   color: var(--fg-2);
+   background: var(--surface-2);
+ }
+ .map-lens-covbar {
+   display: flex;
+   height: 6px;
+   margin: var(--sp-1) 0 var(--sp-1);
+   background: var(--surface-2);
+ }
+ .map-lens-covbar i {
+   display: block;
+   height: 100%;
+ }
+ .map-lens-pair + .map-lens-pair {
+   margin-top: var(--sp-1);
+ }
+ .map-lens-branch {
+   display: flex;
+   align-items: baseline;
+   gap: var(--sp-2);
+ }
+ .map-lens-seat-dot {
+   display: inline-block;
+   width: 7px;
+   height: 7px;
+   margin-right: var(--sp-1);
+   border-radius: 50%;
+ }
+
+ .map-lens {
+   flex: 1;
+   min-height: 0;
+   overflow: auto;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+ .map-lens > header {
+   padding: var(--sp-2) var(--sp-3) var(--sp-2);
+   border-bottom: 1px solid var(--line);
+ }
+ .map-lens h2,
+ .map-lens h3 {
+   margin: 0;
+   font-weight: 500;
+ }
+ .map-lens h2 {
+   font-size: var(--fs-s);
+   color: var(--fg);
+ }
+ .map-lens h3 {
+   font-size: var(--fs-s);
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+   color: var(--muted);
+ }
+ .map-lens-section > p {
+   margin: var(--sp-1) 0 0;
+   line-height: var(--lh);
+ }
+ .map-lens header p {
+   margin: var(--sp-1) 0 0;
+   line-height: var(--lh);
+ }
+ .map-lens-section {
+   padding: var(--sp-2) var(--sp-3);
+   border-bottom: 1px solid var(--line);
+ }
+ .map-lens-row {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto auto;
+   gap: var(--sp-1);
+   align-items: center;
+   padding-top: var(--sp-1);
+ }
+ .map-lens-file,
+ .map-lens-back,
+ .map-pr {
+   width: fit-content;
+   max-width: 100%;
+   padding: 0;
+   border: 0;
+   border-radius: 0;
+   box-shadow: none;
+   background: transparent;
+   color: var(--fg);
+   font: inherit;
+   text-align: left;
+   display: flex;
+   min-width: 0;
+   white-space: nowrap;
+ }
+ .map-lens-directory {
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+ .map-lens-filename {
+   flex: none;
+   white-space: nowrap;
+ }
+ .map-lens-columns {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) auto;
+   gap: var(--sp-1);
+   margin-top: var(--sp-2);
+   color: var(--muted);
+   font-size: var(--fs-s);
+   text-transform: uppercase;
+ }
+ .map-lens-columns span:last-child {
+   text-align: right;
+ }
+ .map-lens-note {
+   color: var(--muted);
+ }
+ .map-lens-file:hover,
+ .map-lens-back:hover {
+   color: var(--accent);
+   text-decoration: underline;
+ }
+ .map-lens-back {
+   color: var(--accent);
+   margin-bottom: var(--sp-1);
+ }
+ .map-lens-kpis {
+   display: grid;
+   grid-template-columns: repeat(4, minmax(0, 1fr));
+   border-bottom: 1px solid var(--line);
+ }
+ .map-lens-kpis b {
+   padding: var(--sp-2) var(--sp-2);
+   border-right: 1px solid var(--line);
+   font-size: var(--fs-panel);
+   color: var(--fg);
+   font-variant-numeric: tabular-nums;
+ }
+ .map-lens-kpis b:last-child {
+   border-right: 0;
+ }
+ .map-lens-kpis small {
+   display: block;
+   margin-top: var(--sp-1);
+   color: var(--muted);
+   font-size: var(--fs-s);
+   font-weight: 400;
+ }
+ .map-pr {
+   display: inline-block;
+   margin: var(--sp-1) var(--sp-1) 0 0;
+   padding: 0 var(--sp-1);
+   border: 1px solid var(--line-2);
+   border-radius: 2px;
+   color: var(--fg-2);
+   text-decoration: none;
+ }
+ .map-pr:hover {
+   color: var(--accent);
+   border-color: var(--accent);
+ }
+ .map-lens .add {
+   color: var(--add, var(--ok));
+   font-family: var(--mono);
+ }
+ .map-lens .rem {
+   color: var(--rem, var(--crit));
+   font-family: var(--mono);
+ }
+ .map-conflict-detail {
+   margin-top: var(--sp-2);
+   padding: 0;
+   border-bottom: 0;
+   font: var(--fs-s) / var(--lh-s) var(--mono);
+   color: var(--fg-2);
+ }
+ .map-conflict-detail h3 {
+   margin: 0 0 var(--sp-1);
+   font-size: var(--fs-s);
+   font-weight: 500;
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+   color: var(--muted);
+ }
+
+ /*
+  * The Crew Activity Map page (docs/design/flight-deck.md around a flat void stage).
+  * The page chrome follows the theme; the stage stays the void in both themes, so its overlay text
+  * uses the stage's own tokens (--void*, in hud.css), never the theme's. No glows, gradients or text shadows: the
+  * seats' lights are the only colour on the stage.
+  */
+ .map-page {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-2);
+   height: 100%;
+   min-height: 0;
+   overflow: hidden;
+ }
+
+ /* header strip: title, repo picker, scope note */
+ .map-head {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-2) var(--sp-4);
+   min-width: 0;
+ }
+ .map-head h1 {
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   white-space: nowrap;
+ }
+ .map-head h1 span {
+   color: var(--muted);
+   font-weight: 500;
+   letter-spacing: 0.02em;
+   text-transform: none;
+   font-family: var(--mono);
+   font-size: var(--fs-panel);
+ }
+ .map-field {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   letter-spacing: 0.08em;
+   text-transform: uppercase;
+   color: var(--muted);
+ }
+ .map-field select {
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   letter-spacing: 0;
+   text-transform: none;
+   min-width: 260px;
+   background: var(--surface-2);
+ }
+ .map-wait {
+   flex: 1;
+   min-height: 0;
+   display: grid;
+   place-items: center;
+   padding: var(--sp-5);
+   text-align: center;
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   background: var(--surface);
+   color: var(--fg-2);
+ }
+ .map-wait p {
+   max-width: 560px;
+ }
+
+ /* stage beside the rail, the deck below */
+ .map-body {
+   flex: 1;
+   min-height: 0;
+   display: grid;
+   grid-template-rows: auto minmax(0, 1fr) auto;
+   gap: var(--sp-2);
+ }
+ .map-key-bar {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-3);
+   min-width: 0;
+   min-height: 30px;
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+ .map-main {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) 300px;
+   gap: var(--sp-2);
+   min-height: 0;
+ }
+ .map-stage-wrap {
+   position: relative;
+   min-width: 0;
+   min-height: 0;
+   border: 1px solid var(--void-line);
+   border-radius: var(--r);
+   overflow: hidden;
+   background: var(--void);
+   color: var(--void-ink);
+ }
+ .map-treemap {
+   --treemap-bg: var(--void);
+   --treemap-folder: var(--void-2);
+   --treemap-line: var(--void-line);
+   --treemap-ink: var(--void-ink);
+   position: absolute;
+   inset: 0;
+   min-width: 0;
+   margin: 0;
+   padding: 0;
+   border: 0;
+   overflow: hidden;
+   background: var(--treemap-bg);
+ }
+ :root[data-theme="light"] .map-treemap {
+   --treemap-bg: var(--surface);
+   --treemap-folder: var(--surface-2);
+   --treemap-line: var(--line-2);
+   --treemap-ink: var(--fg);
+ }
+ @media (prefers-color-scheme: light) {
+   :root:not([data-theme="dark"]) .map-treemap {
+     --treemap-bg: var(--surface);
+     --treemap-folder: var(--surface-2);
+     --treemap-line: var(--line-2);
+     --treemap-ink: var(--fg);
+   }
+ }
+ .map-treemap-folder {
+   position: absolute;
+   box-sizing: border-box;
+   overflow: hidden;
+   border: 1px solid var(--treemap-line);
+   background: var(--treemap-folder);
+   color: var(--muted);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   pointer-events: none;
+ }
+ .map-treemap-folder > .map-treemap-folder-label {
+   display: block;
+   padding: var(--sp-1) var(--sp-1);
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+ .map-treemap-tile {
+   position: absolute;
+   box-sizing: border-box;
+   min-width: 0;
+   min-height: 0;
+   padding: var(--sp-1);
+   overflow: hidden;
+   border: 1px solid var(--treemap-line);
+   border-radius: 1px;
+   box-shadow: none;
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   text-align: left;
+   color: var(--treemap-ink);
+   opacity: calc(0.22 + var(--tile-intensity) * 0.78);
+ }
+ .map-treemap-changes .map-treemap-tile {
+   opacity: 1;
+   background: linear-gradient(
+     var(--tile-split, 90deg),
+     color-mix(in srgb, var(--tile-colour) calc(var(--tile-intensity) * 100%), var(--treemap-folder))
+       50%,
+     color-mix(
+         in srgb,
+         var(--tile-colour-2) calc(var(--tile-intensity-2) * 100%),
+         var(--treemap-folder)
+       )
+       50%
+   );
+ }
+ .map-treemap-changes .map-treemap-tile[data-strong] {
+   color: var(--on-seat);
+ }
+ .map-treemap-changes .map-treemap-tile[data-read] {
+   box-shadow:
+     inset 0 0 0 2px var(--tile-read-colour),
+     inset 0 0 0 4px var(--tile-read-colour-2);
+ }
+ .map-treemap-tile[data-play-current] {
+   outline: 2px solid var(--treemap-ink);
+   outline-offset: -2px;
+ }
+ .map-treemap-marks {
+   position: absolute;
+   inset: 0;
+   pointer-events: none;
+ }
+ .map-treemap-mark {
+   position: absolute;
+   min-width: 14px;
+   box-sizing: border-box;
+   padding: 0 var(--sp-1);
+   border: 1.5px solid var(--mark-colour);
+   border-radius: 8px;
+   background: var(--treemap-bg);
+   color: var(--treemap-ink);
+   font: 600 var(--fs-micro) / var(--lh-micro) var(--mono);
+   text-align: center;
+   transform: translate(-50%, -50%);
+ }
+ .map-treemap-mark[data-current] {
+   background: var(--treemap-ink);
+   color: var(--treemap-bg);
+ }
+ .map-treemap-lines {
+   display: block;
+   font-weight: 600;
+   white-space: nowrap;
+ }
+ .map-treemap-changes .map-treemap-tile[data-neutral] {
+   background: var(--treemap-folder);
+   opacity: 1;
+ }
+ /* a file changed on two open branches: a flat outline and a word, at full seat colour */
+ .map-treemap-tile[data-conflict] {
+   outline: 2px solid var(--rem);
+   outline-offset: -2px;
+ }
+ .map-treemap-badge {
+   display: block;
+   font-weight: 600;
+   white-space: nowrap;
+   color: var(--rem);
+ }
+ .map-treemap-tile[data-conflict][data-strong] .map-treemap-badge {
+   color: var(--on-seat);
+ }
+ .map-treemap-tile:focus-visible {
+   z-index: 2;
+   outline: 2px solid var(--accent);
+   outline-offset: -2px;
+ }
+ .map-treemap-tile > .map-treemap-label {
+   display: block;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ /* the key: one muted line along the stage's foot */
+ .map-key-item {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+ }
+ .map-key-steps {
+   display: inline-flex;
+   gap: 0;
+ }
+ .map-key-swatch {
+   width: 11px;
+   height: 11px;
+   border-radius: 1px;
+   background: var(--seat-1);
+ }
+ .map-key-steps-changes .map-key-swatch-1 {
+   opacity: 0.42;
+ }
+ .map-key-steps-changes .map-key-swatch-2 {
+   opacity: 0.6;
+ }
+ .map-key-steps-changes .map-key-swatch-3 {
+   opacity: 0.8;
+ }
+ .map-key-steps-changes .map-key-swatch-4 {
+   opacity: 1;
+ }
+ .map-changes-key .map-key-muted {
+   color: var(--muted);
+ }
+ .map-changes-key .map-key-conflicts {
+   color: var(--rem);
+ }
+ .map-changes-key {
+   min-width: 0;
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-1) var(--sp-4);
+   margin: 0;
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   color: var(--fg-2);
+ }
+ .map-changes-key .map-key-read {
+   box-sizing: border-box;
+   width: 11px;
+   height: 11px;
+   border: 1.5px solid var(--seat-1);
+   background: transparent;
+ }
+ .map-timeline {
+   grid-column: 1 / -1;
+   min-width: 0;
+   padding: var(--sp-2) var(--sp-2);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   background: var(--surface);
+ }
+ .map-timeline-controls {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   margin-bottom: var(--sp-2);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+   color: var(--muted);
+ }
+ .map-timeline-controls strong {
+   color: var(--fg);
+ }
+ .map-timeline-controls button {
+   font-size: var(--fs-s);
+ }
+ .map-timeline-controls .map-timeline-list {
+   display: grid;
+   gap: var(--sp-1);
+   margin: 0;
+   padding: 0;
+   list-style: none;
+   user-select: none;
+ }
+ .map-timeline-row,
+ .map-timeline-axis {
+   display: grid;
+   grid-template-columns: 8px 84px minmax(0, 1fr);
+   align-items: center;
+   gap: var(--sp-2);
+   min-height: 20px;
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+ .map-timeline-dot {
+   width: 8px;
+   height: 8px;
+   border-radius: 50%;
+ }
+ .map-timeline-seat {
+   overflow: hidden;
+   border: 0;
+   padding: 0;
+   background: transparent;
+   color: var(--fg);
+   text-align: left;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+   cursor: pointer;
+ }
+ .map-timeline-seat[aria-pressed="true"] {
+   text-decoration: underline;
+   text-underline-offset: 3px;
+ }
+ .map-timeline-track {
+   position: relative;
+   height: 16px;
+   border-bottom: 1px solid var(--line);
+   cursor: col-resize;
+ }
+ .map-timeline-window {
+   position: absolute;
+   top: 0;
+   bottom: 0;
+   background: var(--accent-soft);
+   border-inline: 1px solid var(--accent);
+   pointer-events: none;
+ }
+ .map-timeline-tick {
+   position: absolute;
+   top: 3px;
+   width: 3px;
+   height: 10px;
+   background: var(--timeline-seat);
+ }
+ button.map-timeline-tick {
+   padding: 0;
+   border: 0;
+   cursor: pointer;
+ }
+ /* a wider target than the mark itself */
+ .map-timeline-tick::after {
+   position: absolute;
+   inset: -7px -10px;
+   content: "";
+ }
+ .map-timeline-tick:focus-visible,
+ .map-timeline-list:focus-visible {
+   outline: 2px solid var(--accent);
+   outline-offset: 1px;
+ }
+ .map-timeline-tick[data-read] {
+   box-sizing: border-box;
+   top: 4.5px;
+   width: 7px;
+   height: 7px;
+   margin-left: calc(-1 * var(--sp-1));
+   border: 1.3px solid var(--timeline-seat);
+   border-radius: 50%;
+   background: var(--surface);
+ }
+ .map-timeline-tick[data-current] {
+   outline: 2px solid var(--fg);
+   outline-offset: 1px;
+ }
+ .map-timeline-playhead {
+   position: absolute;
+   top: 0;
+   bottom: 0;
+   width: 1.5px;
+   background: var(--fg);
+   pointer-events: none;
+ }
+ .map-timeline-axis-track {
+   position: relative;
+   grid-column: 3;
+   height: 14px;
+   color: var(--muted);
+ }
+ .map-timeline-axis-label {
+   position: absolute;
+   transform: translateX(-50%);
+   white-space: nowrap;
+ }
+ .map-timeline-axis-track .map-timeline-axis-now {
+   right: 0;
+   transform: none;
+ }
+ .map-page .add {
+   color: var(--add);
+   font-weight: 500;
+   font-family: var(--mono);
+ }
+ .map-page .rem {
+   color: var(--rem);
+   font-weight: 500;
+   font-family: var(--mono);
+ }
+
+ /* the rail: the seat selector, then the selection's card */
+ .map-rail {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-2);
+   min-height: 0;
+   min-width: 0;
+ }
+ .map-card {
+   position: relative;
+   min-height: 0;
+   padding: var(--sp-2) var(--sp-3);
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   overflow: auto;
+   overflow-wrap: anywhere;
+ }
+ .map-card-seats {
+   flex: 0 1 auto;
+   max-height: 50%;
+ }
+ .map-card-selected {
+   flex: 1 1 140px;
+ }
+ .map-card > h2 {
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   font-weight: 500;
+   letter-spacing: 0.1em;
+   text-transform: uppercase;
+   color: var(--fg-2);
+   margin: 0 0 var(--sp-2);
+ }
+ /* a seat's light: the same colour as on the stage */
+ .map-light {
+   flex: none;
+   display: inline-block;
+   width: 8px;
+   height: 8px;
+   border-radius: 50%;
+   background: var(--light);
+ }
+ .map-seats {
+   list-style: none;
+   margin: 0 calc(-1 * var(--sp-1));
+   padding: 0;
+   display: grid;
+   gap: 0;
+ }
+ .map-seat {
+   width: 100%;
+   display: grid;
+   grid-template-columns: 8px auto minmax(0, 1fr) auto;
+   align-items: center;
+   gap: var(--sp-2);
+   padding: var(--sp-1) var(--sp-1);
+   text-align: left;
+   font-family: var(--mono);
+   font-size: var(--fs-micro);
+   background: transparent;
+   border: 0;
+   border-radius: var(--r-s);
+   box-shadow: none;
+ }
+ .map-seat:hover {
+   background: var(--surface-2);
+ }
+ .map-seat[aria-pressed="true"] {
+   background: var(--accent-soft);
+   box-shadow: inset 2px 0 0 var(--accent);
+ }
+ .map-seat-name {
+   color: var(--fg);
+   font-weight: 500;
+ }
+ .map-seat:hover .map-seat-name,
+ .map-seat[aria-pressed="true"] .map-seat-name {
+   color: var(--fg);
+ }
+ .map-seat-on {
+   color: var(--fg-2);
+   white-space: nowrap;
+   overflow: hidden;
+   text-overflow: ellipsis;
+ }
+ .map-seat-conflict {
+   color: var(--rem);
+   font-weight: 500;
+   white-space: nowrap;
+ }
+ .map-seat-on.none {
+   color: var(--muted);
+ }
+ .map-empty {
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+   margin-block: var(--sp-1);
+ }
+ .map-find {
+   width: 100%;
+   box-sizing: border-box;
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   margin-bottom: var(--sp-2);
+ }
+ .map-results {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-1);
+   max-height: 160px;
+   overflow: auto;
+   margin-bottom: var(--sp-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   color: var(--muted);
+ }
+ .map-results button {
+   text-align: left;
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   padding: var(--sp-1) var(--sp-2);
+   white-space: normal;
+   overflow-wrap: anywhere;
+ }
+ .map-detail {
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+   color: var(--fg-2);
+ }
+ .map-detail h3 {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   font-weight: 500;
+   color: var(--fg);
+   margin-block: var(--sp-1) var(--sp-1);
+ }
+ .map-detail h4 {
+   font-size: var(--fs-s);
+   font-weight: 500;
+   color: var(--muted);
+   margin-block: var(--sp-2) var(--sp-1);
+   text-transform: uppercase;
+   letter-spacing: 0.1em;
+ }
+ .map-detail-on {
+   color: var(--fg);
+   margin-block: 0 var(--sp-2);
+ }
+ .map-facts {
+   display: grid;
+   grid-template-columns: auto minmax(0, 1fr);
+   gap: var(--sp-1) var(--sp-3);
+   margin: 0;
+ }
+ .map-facts dt {
+   color: var(--muted);
+ }
+ .map-facts dd {
+   margin: 0;
+   font-variant-numeric: tabular-nums;
+ }
+ .map-who {
+   list-style: none;
+   margin: 0;
+   padding: 0;
+   display: grid;
+   gap: var(--sp-1);
+ }
+ .map-who li {
+   display: grid;
+   grid-template-columns: 8px auto minmax(0, 1fr);
+   align-items: center;
+   gap: var(--sp-2);
+ }
+ .map-who-count {
+   justify-self: end;
+   font-variant-numeric: tabular-nums;
+ }
+ .map-detail-actions {
+   display: flex;
+   gap: var(--sp-1);
+   margin-top: var(--sp-2);
+ }
+ .map-note {
+   color: var(--muted);
+   font-size: var(--fs-s);
+ }
+
+ /* the deck: live status */
+ .map-deck {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: var(--sp-1) var(--sp-3);
+   padding: var(--sp-2) var(--sp-3);
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+ }
+ .map-live {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2);
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   color: var(--fg-2);
+ }
+ .map-live i {
+   width: 8px;
+   height: 8px;
+   border-radius: 50%;
+   background: var(--accent);
+   animation: map-live 2.4s ease-in-out infinite;
+ }
+ .map-live.down i {
+   background: var(--warn);
+   animation: none;
+ }
+ @keyframes map-live {
+   50% {
+     opacity: 0.35;
+   }
+ }
+
+ @media (prefers-reduced-motion: reduce) {
+   .map-live i {
+     animation: none;
+   }
+ }
+
+ .map-timeline-presets {
+   display: inline-flex;
+   align-items: center;
+   gap: var(--sp-1);
+ }
+
+ /* QA deep links select every changed path while preserving the crew's change colours. */
+ .map-treemap-tile[data-pr-selected="true"] {
+   outline: 2px solid var(--accent);
+   outline-offset: -2px;
+   z-index: 2;
+ }
+
+ .process-line {
+   display: flex;
+   align-items: baseline;
+   min-width: 0;
+ }
+
+ .process-line > .ellip {
+   min-width: 0;
+ }
+
+ .process-line > .num {
+   flex: none;
+   white-space: pre;
+ }
+
+ .stepbar {
+   display: flex;
+   gap: var(--sp-1);
+   margin: var(--sp-1) 0 var(--sp-1);
+ }
+
+ .stepbar i {
+   flex: 1;
+   height: 4px;
+   border-radius: 2px;
+   background: var(--line-2);
+ }
+
+ .stepbar i.d {
+   background: var(--fg-2);
+ }
+
+ .stepbar i.c {
+   background: var(--ok);
+ }
+
+ .stepbar i.w {
+   background: var(--warn-mark);
+ }
+
+ /* biome-ignore-all lint/style/noDescendingSpecificity: later rules override earlier ones by order here, as in hud.css */
+ /* A link in a panel head to the page that goes deeper (the Timeline's to the activity map). */
+ .ph .act .ph-link {
+   display: inline-flex;
+   align-items: center;
+   min-height: 24px;
+   font-family: var(--mono);
+   font-size: var(--fs-s);
+   font-weight: 400;
+   letter-spacing: 0.04em;
+   text-transform: none;
+   color: var(--accent);
+   text-decoration: none;
+   white-space: nowrap;
+ }
+
+ .ph .act .ph-link:hover,
+ .ph .act .ph-link:focus-visible {
+   text-decoration: underline;
+ }
+
+ /* overview */
+ #page-overview {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-3);
+   overflow: hidden;
+ }
+
+ #page-overview > #nbanner {
+   flex-shrink: 0;
+ }
+
+ .overview-grid {
+   flex: 1;
+   min-height: 0;
+   display: grid;
+   /* Each group keeps its content height; the roster and evidence lists have bounded scrolling. */
+   grid-template-rows: max-content max-content max-content;
+   align-content: start;
+   gap: var(--sp-3);
+   overflow-y: auto;
+ }
+
+ .overview-grid > *,
+ .overview-work > .panel,
+ .ov > .panel {
+   min-height: 0;
+   min-width: 0;
+   overflow: hidden;
+ }
+
+ .overview-metrics {
+   overflow: auto;
+ }
+
+ .overview-grid .ph {
+   flex-shrink: 0;
+   flex-wrap: nowrap;
+   padding: var(--sp-2) var(--sp-3) var(--sp-2);
+ }
+
+ /* A header is one line: the title and controls keep their size and the subtitle gives way. */
+ .overview-grid .ph h2 {
+   flex: none;
+   white-space: nowrap;
+ }
+
+ .overview-grid .ph .sub {
+   min-width: 0;
+   overflow: hidden;
+   text-overflow: ellipsis;
+   white-space: nowrap;
+ }
+
+ .overview-grid .ph .act {
+   flex: none;
+   flex-wrap: nowrap;
+ }
+
+ .overview-grid .ph h2 {
+   font-family: var(--sans);
+   font-size: var(--fs);
+   font-weight: 600;
+ }
+
+ #timelineP {
+   align-self: start;
+   max-height: 100%;
+ }
+
+ .overview-work {
+   display: grid;
+   grid-template-columns: minmax(0, 1fr) minmax(260px, 0.4fr);
+   grid-template-rows: max-content;
+   align-items: start;
+   gap: var(--sp-3);
+ }
+
+ .nbanner {
+   display: flex;
+   align-items: center;
+   gap: var(--sp-2) var(--sp-3);
+   flex-wrap: wrap;
+   padding: var(--sp-2) var(--sp-3);
+   border: 1px solid var(--warn-mark);
+   background: var(--warn-soft);
+   border-radius: var(--r);
+   cursor: pointer;
+   text-align: left;
+   width: 100%;
+   color: var(--fg);
+ }
+
+ .nbanner:hover {
+   border-color: var(--warn);
+ }
+
+ .nbanner b {
+   font-family: var(--display);
+   font-size: var(--fs-title);
+   font-weight: 600;
+   color: var(--warn);
+ }
+
+ .nbanner .bits {
+   display: flex;
+   gap: var(--sp-1) var(--sp-3);
+   flex-wrap: wrap;
+   color: var(--fg-2);
+   font-size: var(--fs-s);
+ }
+
+ .nbanner.clear {
+   border-color: var(--line);
+   background: var(--surface);
+   cursor: default;
+ }
+
+ .nbanner.clear b {
+   color: var(--ok);
+ }
+
+ .nbanner .bit {
+   font-size: var(--fs-panel);
+ }
+
+ .nbanner .accent {
+   color: var(--accent);
+ }
+
+ .quotawarn {
+   margin-top: var(--sp-1);
+ }
+
+ .ov {
+   min-height: 0;
+   display: grid;
+   align-items: start;
+   grid-template-columns: minmax(0, 1.4fr) minmax(260px, 1fr) minmax(300px, 1fr);
+   grid-template-rows: minmax(280px, max-content);
+   gap: var(--sp-3);
+ }
+
+ .ov > #actP {
+   /* Size containment keeps long logs bounded by their neighbours; only the log stretches. */
+   align-self: stretch;
+ }
+
+ /* Quota joins Next actions beside the Live log. */
+ .ov > .col {
+   display: contents;
+ }
+
+ .ov > .col > .panel {
+   overflow: hidden;
+   min-width: 0;
+   min-height: 0;
+ }
+
+ .ov > .col > .panel > .pb {
+   min-height: 0;
+   overflow: auto;
+ }
+
+ .overview-axis {
+   position: sticky;
+   top: 0;
+   z-index: 3;
+   background: var(--surface);
+   height: var(--sp-5);
+   margin-left: calc(var(--lane-label) + var(--sp-2));
+   border-top: 1px solid var(--line-2);
+   font: var(--fs-micro) / var(--lh-micro) var(--mono);
+ }
+
+ .overview-axis > span {
+   position: absolute;
+   top: 4px;
+   transform: translateX(-50%);
+   white-space: nowrap;
+ }
+
+ .overview-axis > span::before {
+   content: "";
+   position: absolute;
+   top: -5px;
+   left: 50%;
+   height: 4px;
+   border-left: 1px solid var(--line-2);
+ }
+
+ .overview-axis > span:first-child {
+   transform: none;
+ }
+
+ .overview-axis > span:first-child::before {
+   left: 0;
+ }
+
+ .overview-axis > span:last-child {
+   transform: translateX(-100%);
+   color: var(--accent);
+ }
+
+ .overview-axis > span:last-child::before {
+   left: auto;
+   right: 0;
+ }
+
+ .timeline-body {
+   /* the lane labels' column; the axis below the lanes starts after it and its gap */
+   --lane-label: 92px;
+   display: flex;
+   flex-direction: column;
+ }
+
+ .timeline-body > :not(.overview-lanes) {
+   flex: none;
+ }
+
+ .overview-lanes {
+   position: relative;
+   display: grid;
+   grid-template-rows: repeat(var(--lane-count), max-content);
+   gap: var(--sp-2);
+ }
+
+ /* now: a thin cursor down the right edge of every track */
+ .overview-lanes::after {
+   content: "";
+   position: absolute;
+   top: 0;
+   bottom: 0;
+   right: 0;
+   border-right: 1px solid var(--accent);
+   opacity: 0.8;
+   pointer-events: none;
+ }
+
+ @media (prefers-reduced-motion: no-preference) {
+   .overview-lanes::after {
+     animation: now-pulse 2.4s ease-in-out infinite;
+   }
+ }
+
+ .overview-lanes:empty {
