+   align-items: center;
+   gap: var(--sp-2);
+   margin: 0;
+ }
+
+ .tk-head h1 {
+   margin: 0;
+   font-size: var(--fs-title);
+   line-height: var(--lh-title);
+   overflow-wrap: anywhere;
+ }
+
+ .tk-grid {
+   display: grid;
+   grid-template-columns: minmax(320px, 2fr) minmax(0, 3fr);
+   gap: var(--sp-4);
+   min-height: 0;
+   align-items: start;
+ }
+
+ .tk-grid .pb {
+   max-height: 70vh;
+   min-height: 0;
+ }
+
+ .tk-fields {
+   display: grid;
+   grid-template-columns: repeat(2, minmax(0, 1fr));
+   gap: var(--sp-2) var(--sp-4);
+   margin: 0 0 var(--sp-3);
+ }
+
+ .tk-field dt {
+   font-size: var(--fs-s);
+   color: var(--fg2);
+ }
+
+ .tk-field dd {
+   margin: 0;
+   overflow-wrap: anywhere;
+ }
+
+ .tk-form h3 {
+   margin: var(--sp-3) 0 var(--sp-1);
+   font-size: var(--fs-panel);
+ }
+
+ .tk-text {
+   margin: 0;
+   overflow-wrap: anywhere;
+   white-space: pre-wrap;
+ }
+
+ .tk-done,
+ .tk-prs,
+ .tk-events,
+ .tk-findings ul {
+   list-style: none;
+   margin: 0;
+   padding: 0;
+ }
+
+ .tk-done li {
+   display: grid;
