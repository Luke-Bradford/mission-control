+
+ .loop-chain {
+   position: relative;
+   display: grid;
+   grid-template-columns: repeat(6, 170px);
+   gap: var(--sp-6);
+   min-width: 1200px;
+   /* room under the steps for the routes and the FLIGHT box, drawn 320px tall from the top */
+   min-height: 320px;
+   align-content: start;
+   padding: var(--sp-4) 0 var(--sp-7);
+ }
+
+ .loop-routes {
+   position: absolute;
+   inset: 0;
+   width: 1280px;
+   height: 320px;
+   overflow: visible;
+   pointer-events: none;
