+   gap: var(--sp-1);
+   cursor: pointer;
+   text-align: left;
+ }
+
+ .kcard {
+   position: relative;
+ }
+
+ /* the title link covers the card, so the whole card opens it; GitHub links sit above the cover */
+ .kcard .ktitle::after {
+   content: "";
+   position: absolute;
+   inset: 0;
+ }
+
+ .kcard .rref a {
+   position: relative;
