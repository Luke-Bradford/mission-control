+
+ .pipeline-stage.review {
+   --stage-colour: var(--think);
+ }
+
+ .pipeline-stage.merging {
+   --stage-colour: var(--ok);
+ }
+
+ .pipeline-stage.merged {
+   --stage-colour: var(--ok);
+ }
+
+ .pipeline-stage h3 {
+   flex: none;
+   display: flex;
+   align-content: start;
+   align-items: baseline;
+   flex-wrap: wrap;
+   gap: var(--sp-1) var(--sp-1);
+   margin: 0;
+   padding-bottom: 0;
+   font-size: var(--fs-s);
+   font-weight: 500;
+   text-transform: uppercase;
+   letter-spacing: 0.06em;
