+
+ /* Overview v2 metrics and stream freshness. */
+ .overview-kpis {
+   display: grid;
+   grid-template-columns: repeat(8, minmax(0, 1fr));
+   gap: 0;
+   border: 1px solid var(--line);
+   border-radius: var(--r);
+   background: var(--surface);
+ }
+
+ .overview-kpi {
+   display: grid;
+   min-width: 0;
+   /* the label row grows when a narrow tile wraps its name above its window */
+   grid-template-rows: minmax(16px, auto) 28px minmax(16px, auto);
+   gap: var(--sp-1);
+   padding: var(--sp-1) var(--sp-3);
+   border: 0;
+   border-right: 1px solid var(--line);
+   border-radius: 0;
+   color: var(--fg);
+   text-decoration: none;
+ }
+
+ .overview-kpi:hover,
+ .overview-kpi:focus-visible {
