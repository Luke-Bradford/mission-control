+
+ .loop-route path,
+ .loop-route marker {
+   fill: var(--warn);
+ }
+
+ .loop-route.review-return {
+   stroke-dasharray: 5 4;
+ }
+
+ .loop-route.conflict-route {
+   stroke: var(--crit);
+   stroke-dasharray: 5 4;
+ }
+
+ .loop-route.flight-return {
+   stroke: var(--think);
+   stroke-dasharray: 5 4;
+ }
+
+ .loop-route.active {
+   stroke-width: 3;
+   filter: drop-shadow(0 0 2px var(--warn));
