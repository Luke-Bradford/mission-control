+
+ .overview-kpi .lbl {
+   font-size: var(--fs-s);
+   line-height: var(--lh-s);
+   color: var(--muted);
+   white-space: normal;
+   overflow-wrap: break-word;
+   text-transform: uppercase;
+   letter-spacing: 0.06em;
