+ /* Inset rings stay visible inside the compact cells' clipping bounds. */
+ #agentsList a:focus-visible,
+ #agentsList button:focus-visible,
+ #agentsList select:focus-visible,
+ .overview-lane:focus-visible {
+   outline-offset: -2px;
+ }
+
+ /* Content redesign: stable independent columns preserve panel readers across rail changes. */
+ .overview-workspace {
+   position: relative;
+   container: workspace / inline-size;
+   display: grid;
+   grid-template-columns: minmax(1050px, 1200px) minmax(340px, 1fr);
+   align-items: start;
+   gap: var(--sp-3);
+ }
+ .overview-primary,
+ .overview-secondary {
+   display: flex;
+   flex-direction: column;
+   gap: var(--sp-3);
+   min-width: 0;
+ }
