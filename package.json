{
  "name": "mission-control",
  "private": true,
  "packageManager": "pnpm@11.28.7",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter @mc/web build",
    "lint": "biome check . && node --experimental-strip-types scripts/check-core-cycles.ts",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:related": "node --experimental-strip-types scripts/check-related.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
